  code            String   @unique
  name            String
  alias           String?
  functionDesc    String?
  floorsCount     Int      @default(1)
  roomsCount      Int      @default(0)
  capacity        Int      @default(0)
  picName         String?
  picPhone        String?
  status          String   @default("Aktif Beroperasi")
  establishedYear Int      @default(2020)
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms           Room[]

  @@map("buildings")
}

model Room {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  buildingId      String
  buildingCode    String
  buildingName    String
  floor           Int      @default(1)
  type            String   @default("Kelas Teori")
  capacity        Int      @default(40)
  facilities      String[] @default([])
  status          String   @default("Tersedia")
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
