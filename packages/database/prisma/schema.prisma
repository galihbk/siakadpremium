  nim       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account          PmbAccount                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wave             AdmissionBatch?            @relation(fields: [waveId], references: [id], onDelete: SetNull)
  registrationType AdmissionRegistrationType? @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track            AdmissionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass   AdmissionClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  studyProgram     StudyProgram?              @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  student          Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)

