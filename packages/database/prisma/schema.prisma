// ==============================================================================
// MASTER KOMPONEN BIAYA & ATURAN PEMBIAYAAN (FEE RULES ENGINE)
// ==============================================================================

model FeeComponent {
  id            String               @id @default(uuid())
  code          String               @unique // e.g. "SPP", "SKS", "PRAKTIKUM", "UJIAN", "REGISTRASI", "WISUDA"
  name          String               // e.g. "SPP / Uang Kuliah Tunggal", "Biaya SKS Perkuliahan"
  defaultAmount Float                // Tarif dasar standar (Rp)
  category      String               @default("SEMESTER") // "SEMESTER", "PER_SKS", "SEKALI_BAYAR"
  description   String?              @db.Text
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  ruleItems     FeeRuleItem[]
  invoiceItems  PaymentInvoiceItem[]

  @@map("fee_components")
}

enum FeeRuleBillingMode {
  UKT
  PER_SKS
}

model FeeRule {
  id                 String                     @id @default(uuid())
  name               String                     // e.g. "Aturan Beasiswa KIP-Kuliah"
  code               String                     @unique // e.g. "RULE_KIP"
  description        String?                    @db.Text
  priority           Int                        @default(10) // Prioritas: angka makin besar makin prioritas
  academicYear       String?                    // null = berlaku untuk semua tahun akademik
  billingMode        FeeRuleBillingMode         @default(UKT) // UKT = flat per semester, PER_SKS = tarif x SKS diambil
  isActive           Boolean                    @default(true)

  // Kondisi opsional pencocokan rule
  registrationTypeId String?
  trackId            String?
  classId            String?
  studyProgramId     String?
  waveId             String?

  registrationType   AdmissionRegistrationType? @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track              AdmissionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass     AdmissionClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  studyProgram       StudyProgram?              @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  wave               AdmissionBatch?            @relation(fields: [waveId], references: [id], onDelete: SetNull)

  ruleItems          FeeRuleItem[]
  assignments        StudentFeeAssignment[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@map("fee_rules")
}

model FeeRuleItem {
  id             String       @id @default(uuid())
  feeRuleId      String
  feeComponentId String
  actionType     String       @default("NORMAL") // "NORMAL", "BEBAS", "DISKON_PERSENTASE", "DISKON_NOMINAL", "TARIF_KHUSUS"
  amountValue    Float?       // Nilai diskon persen / diskon nominal / tarif khusus
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  feeRule        FeeRule      @relation(fields: [feeRuleId], references: [id], onDelete: Cascade)
  feeComponent   FeeComponent @relation(fields: [feeComponentId], references: [id], onDelete: Restrict)

  @@unique([feeRuleId, feeComponentId])
  @@map("fee_rule_items")
}

model StudentFeeAssignment {
  id           String    @id @default(uuid())
  studentId    String
  feeRuleId    String?
  academicYear String    // e.g. "2026/2027"
  schemeName   String    // e.g. "Skema Beasiswa KIP-Kuliah", "Skema Reguler Mandiri"
  snapshotData Json      // Snapshot rincian aturan & komponen saat penetapan dilakukan
  notes        String?   @db.Text
  assignedAt   DateTime  @default(now())
  assignedBy   String?   @default("SISTEM_PMB")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeRule      FeeRule?  @relation(fields: [feeRuleId], references: [id], onDelete: SetNull)

  @@index([studentId, academicYear])
  @@map("student_fee_assignments")
}

model PaymentInvoiceItem {
  id             String         @id @default(uuid())
  invoiceId      String
  feeComponentId String?
  componentName  String
  baseAmount     Float
  actionType     String         @default("NORMAL") // "NORMAL", "BEBAS", "DISKON_PERSENTASE", "DISKON_NOMINAL", "TARIF_KHUSUS"
  actionValue    Float?
  discountAmount Float          @default(0)
  finalAmount    Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoice        PaymentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeComponent   FeeComponent?  @relation(fields: [feeComponentId], references: [id], onDelete: SetNull)

  @@map("payment_invoice_items")
}


