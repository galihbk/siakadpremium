datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN_BAAK
  ADMIN_PMB
  ADMIN_KEUANGAN
  ADMIN_LP3M
  LP3M
  ADMIN_P2M
  P2M
  ADMIN_PRODI
  SDM
  LECTURER
  STUDENT
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

enum StructuralPosition {
  DEKAN
  KAPRODI
}

enum StudentStatus {
  ACTIVE
  LEAVE
  GRADUATED
  DROPOUT
  TRANSFERRED
}

enum SemesterType {
  ODD
  EVEN
  SHORT
}

enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DegreeLevel {
  D3
  D4
  S1
  S2
  S3
  PROFESI
}

enum AdmissionStatus {
  PENDING
  VERIFIED
  PASSED
  FAILED
  REGISTERED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  // true = masih memakai kata sandi awal (mis. tanggal lahir) dan wajib menggantinya saat login berikutnya
  mustChangePassword Boolean @default(false)
  fullName       String
  role           Role     @default(STUDENT)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  // Dipakai khusus role ADMIN_PRODI -- menandai program studi yang dikelola akun ini.
  studyProgramId String?
  // Shift kerja (jam absen) yang berlaku untuk dosen/karyawan ini.
  shiftId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student                      Student?
  lecturer                     Lecturer?
  studyProgram                 StudyProgram?          @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  shift                        Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  notifications                Notification[]
  updatedLandingPageSettings   LandingPageSetting[]
  landingPageArticles          LandingPageArticle[]
  editedLandingPageArticles    LandingPageArticle[]   @relation("ArticleEditor")
  uploadedFiles                UploadedFile[]
  passwordResetTokens          PasswordResetToken[]
  updatedBankGatewaySettings   BankGatewaySetting[]
  updatedPddiktiSettings       PddiktiSetting[]
  salarySetting                SalarySetting?
  salaryComponents             SalaryComponent[]
  dailyAttendances             DailyAttendance[]
  updatedTransportRateSettings TransportRateSetting[]
  honorPayments                HonorPayment[]
  employeeProfile              EmployeeProfile?

  @@map("users")
}

/// Profil kepegawaian yang diisi Biro SDM (menimpa nilai bawaan yang diturunkan dari role/dosen).
/// Jabatan struktural (mis. Kepala Bagian, Dekan, Kaprodi) dan jabatan fungsional (mis. Lektor Kepala,
/// Pranata Komputer) disimpan terpisah.
model EmployeeProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  nip                  String?
  nidn                 String?
  gender               String?
  category             String?
  employmentStatus     String?
  department           String?
  structuralPosition   String?
  functionalPosition   String?
  education            String?
  phone                String?
  joinDate             String?
  // Khusus pegawai outsourcing: perusahaan penyedia tenaga kerja (vendor).
  vendorName           String?
  // Email kontak pegawai non-dosen (yang tidak punya akun login).
  contactEmail         String?
  // Alamat domisili
  streetAddress        String?
  rtRw                 String?
  kelurahan            String?
  kecamatan            String?
  city                 String?
  province             String?
  postalCode           String?
  // Riwayat pendidikan terakhir
  educationInstitution String?
  educationMajor       String?
  graduationYear       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

model SalarySetting {
  id               String   @id @default(uuid())
  userId           String   @unique
  baseSalary       Int      @default(0)
  // Beban mengajar wajib (SKS) yang tidak dibayar honor -- honor mengajar dihitung dari
  // SKS bersih (Total SKS diampu - Beban Mengajar), bukan total SKS mentah.
  bebanMengajarSks Int      @default(0)
  notes            String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_settings")
}

// Rincian tunjangan & potongan gaji per pegawai (mis. Tunjangan Jabatan, BPJS Kesehatan, PPh 21, dst).
model SalaryComponent {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'TUNJANGAN' | 'POTONGAN'
  name      String
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("salary_components")
}

// Snapshot honor yang sudah dibayarkan untuk satu pegawai di satu periode bulan pembayaran --
// disimpan terpisah dari perhitungan live supaya kalau data SKS/honor dikoreksi belakangan,
// angka yang SUDAH dibayarkan tidak ikut berubah (tetap sesuai yang benar-benar dikirim bulan itu).
model HonorPayment {
  id             String   @id @default(uuid())
  userId         String
  periodMonth    Int // 1-12
  periodYear     Int
  academicYearId String?
  baseSalary     Int      @default(0)
  totalTunjangan Int      @default(0)
  totalPotongan  Int      @default(0)
  honorMengajar  Int      @default(0)
  transportTotal Int      @default(0)
  totalHonor     Int      @default(0)
  paidAt         DateTime @default(now())
  paidBy         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodMonth, periodYear])
  @@map("honor_payments")
}

// Absen mandiri harian dosen/karyawan (pagi & sore), dasar perhitungan uang transport otomatis.
model DailyAttendance {
  id          String    @id @default(uuid())
  userId      String
  date        DateTime  @db.Date
  checkInPagi DateTime?
  checkInSore DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_attendances")
}

// Tarif uang transport per sesi (pagi/sore), berlaku global untuk semua dosen & karyawan.
model TransportRateSetting {
  id        String   @id @default("default-transport-rate")
  ratePagi  Int      @default(0)
  rateSore  Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  updatedByUserId String?
  updatedByUser   User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("transport_rate_settings")
}

// Tarif honor mengajar per SKS, berbeda untuk tiap jenjang prodi yang diajar (D3/D4/S1/S2/S3/Profesi) --
// dosen yang mengajar di prodi S2 misalnya dapat tarif per-SKS yang berbeda dari yang mengajar di D3.
model HonorRateJenjang {
  id          String      @id @default(uuid())
  degreeLevel DegreeLevel @unique
  ratePerSks  Int         @default(0)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@map("honor_rate_jenjang")
}

// Template jam kerja (shift) -- dosen/karyawan diassign ke salah satu, dipakai untuk
// menentukan apakah absen pagi/sore mereka tepat waktu atau terlambat.
model Shift {
  id            String   @id @default(uuid())
  name          String
  startPagi     String? // "HH:mm", kosong kalau shift ini tidak punya sesi pagi
  toleransiPagi Int      @default(15) // menit
  startSore     String? // "HH:mm", kosong kalau shift ini tidak punya sesi sore
  toleransiSore Int      @default(15) // menit
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users User[]

  @@map("shifts")
}

model Faculty {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  description     String?
  building        String?
  establishedYear Int?
  accreditation   String?
  skAkreditasi    String?
  // Visi & misi ditampilkan di situs publik; diisi Super Admin. Misi: satu poin per baris.
  vision          String?  @db.Text
  mission         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studyPrograms StudyProgram[]
  // Dekan TIDAK disimpan sebagai teks manual -- diturunkan dari Lecturer yang
  // structuralPosition-nya DEKAN & structuralFacultyId mengarah ke fakultas ini.
  // Kalau jabatan struktural dosen diganti, nama dekan di sini otomatis ikut berubah.
  deanLecturers Lecturer[]     @relation("FacultyDekan")

  @@map("faculties")
}

model StudyProgram {
  id                      String      @id @default(uuid())
  facultyId               String
  code                    String      @unique
  diktiCode               String?
  name                    String
  degreeLevel             DegreeLevel @default(S1)
  degreeTitle             String?
  accreditation           String      @default("Unggul")
  accreditationAgency     String?     @default("BAN-PT / LAM")
  skAkreditasi            String?
  accreditationValidUntil String?
  vision                  String?     @db.Text
  mission                 String?     @db.Text
  status                  String      @default("Aktif")
  studentsCount           Int         @default(0)
  lecturersCount          Int         @default(0)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  faculty               Faculty                @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students              Student[]
  lecturers             Lecturer[]
  courses               Course[]
  admissionApplications AdmissionApplication[]
  feeRules              FeeRule[]
  // Akun role ADMIN_PRODI yang mengelola program studi ini.
  prodiAdminUsers       User[]
  // Kaprodi TIDAK disimpan sebagai teks manual -- diturunkan dari Lecturer yang
  // structuralPosition-nya KAPRODI & structuralStudyProgramId mengarah ke prodi ini.
  kaprodiLecturers      Lecturer[]             @relation("ProdiKaprodi")

  admissionTracks  AdmissionTrack[] @relation("AdmissionTrackPrograms")
  admissionClasses AdmissionClass[] @relation("AdmissionClassPrograms")

  @@map("study_programs")
}

model Lecturer {
  id                String  @id @default(uuid())
  userId            String  @unique
  studyProgramId    String
  // Dosen bisa punya NIDN, NUPTK, atau dua-duanya (terkonfirmasi dari tampilan Neo
  // Feeder sungguhan) -- makanya nidn TIDAK boleh wajib/unik tunggal lagi. Minimal
  // salah satu dari nidn/nuptk harus terisi, divalidasi di level aplikasi, bukan skema.
  nidn              String? @unique
  nuptk             String? @unique
  nip               String? @unique
  nidk              String?
  // id_dosen dari Neo Feeder -- kunci paling stabil untuk mencocokkan ulang data saat
  // re-sync, karena NIDN/NUPTK dosen baru kadang belum terbit saat pertama ditarik.
  feederId          String? @unique
  nik               String? @unique
  npwp              String?
  titlePrefix       String?
  titleSuffix       String?
  phone             String?
  officePhone       String?
  isAcademicAdvisor Boolean @default(true)

  // Identitas Diri
  gender           Gender?
  birthDate        DateTime?
  birthPlace       String?
  religion         String?
  motherName       String?
  maritalStatus    String?
  spouseName       String?
  spouseNip        String?
  spouseOccupation String?

  // Alamat
  address    String? @db.Text
  dusun      String?
  rtRw       String?
  kelurahan  String?
  kecamatan  String?
  city       String?
  province   String?
  postalCode String?

  // Kepegawaian & Akademik
  employmentStatus      String?
  functionalPosition    String?
  lastEducation         String?
  expertise             String?
  sdmType               String?
  rankGroup             String?
  salarySource          String?
  skNumber              String?
  skDate                DateTime?
  appointingInstitution String?

  // Data Tambahan
  bpjsKesehatan       String?
  bpjsKetenagakerjaan String?

  // Jabatan struktural (Dekan/Kaprodi) -- sumber kebenaran untuk Faculty.deanLecturers
  // & StudyProgram.kaprodiLecturers. structuralFacultyId dipakai kalau DEKAN,
  // structuralStudyProgramId dipakai kalau KAPRODI; yang lain dibiarkan null.
  structuralPosition       StructuralPosition?
  structuralFacultyId      String?
  structuralStudyProgramId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram           StudyProgram        @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  advisedStudents        Student[]           @relation("AcademicAdvisor")
  courseClasses          CourseClass[]
  practiceClasses        CourseClass[]       @relation("PracticeLecturer")
  thesisAsSupervisor1    ThesisSupervision[] @relation("ThesisSupervisor1")
  thesisAsSupervisor2    ThesisSupervision[] @relation("ThesisSupervisor2")
  structuralFaculty      Faculty?            @relation("FacultyDekan", fields: [structuralFacultyId], references: [id], onDelete: SetNull)
  structuralStudyProgram StudyProgram?       @relation("ProdiKaprodi", fields: [structuralStudyProgramId], references: [id], onDelete: SetNull)

  thesisProjectsAsSupervisor1 ThesisProject[]         @relation("ThesisProjectSupervisor1")
  thesisProjectsAsSupervisor2 ThesisProject[]         @relation("ThesisProjectSupervisor2")
  thesisGuidances             ThesisGuidance[]        @relation("ThesisGuidanceLecturer")
  thesisApprovals             ThesisApproval[]        @relation("ThesisApprovalLecturer")
  thesisExaminerRoles         ThesisDefenseExaminer[] @relation("ThesisExaminerLecturer")

  examProctor1 ExamSchedule[] @relation("ExamProctor1")
  examProctor2 ExamSchedule[] @relation("ExamProctor2")

  @@map("lecturers")
}

model Student {
  id                   String        @id @default(uuid())
  // Perguruan tinggi asal -- diisi bila jenis mahasiswa bukan mahasiswa baru (pindahan/RPL); dikirim ke Feeder
  originInstitution  String?
  originInstitutionCode String? // kode perguruan tinggi 6 digit (PDDIKTI/Feeder), bila dipilih dari pencarian
  originInstitutionId  String? // id_perguruan_tinggi Feeder, bila dipilih dari pencarian Feeder
  originStudyProgram String?
  originStudyProgramLevel String? // jenjang prodi asal (S1, S2, D3, ...), bila dipilih dari pencarian
  originStudyProgramId String? // id_prodi Feeder, bila dipilih dari pencarian Feeder
  originNim          String?
  originCredits      Int? // SKS yang diakui (diisi setelah evaluasi), bawaan 0 saat dikirim ke Feeder

  userId               String        @unique
  studyProgramId       String
  advisorLecturerId    String?
  // id_mahasiswa dari Neo Feeder (biodata) -- kunci paling stabil untuk mencocokkan ulang
  // data saat re-sync, sama seperti feederId di Lecturer.
  feederId             String?       @unique
  // id_registrasi_mahasiswa dari Neo Feeder -- BEDA dari feederId (biodata). Diisi hanya
  // setelah mahasiswa benar-benar terdaftar (riwayat pendidikan) di Feeder, dipakai Push
  // Mahasiswa Baru untuk tahu siapa yang masih perlu didaftarkan vs yang sudah selesai.
  feederRegistrationId String?       @unique
  // Pesan error terakhir kalau Push mahasiswa ini ke Feeder gagal -- dikosongkan lagi begitu
  // Push berikutnya untuk mahasiswa ini berhasil. Dipakai halaman Sinkronisasi Feeder (tab Push).
  feederSyncError      String?       @db.Text
  feederSyncErrorAt    DateTime?
  nim                  String        @unique
  gender               Gender        @default(MALE)
  birthDate            DateTime?
  birthPlace           String?
  phone                String?
  nik                  String?
  nisn                 String?
  noKk                 String?
  address              String?       @db.Text
  streetAddress        String?       @db.Text
  rtRw                 String?
  dusun                String?
  kelurahan            String?
  kecamatan            String?
  city                 String?
  province             String?
  postalCode           String?
  religion             String?
  entryYear            Int
  currentSemester      Int           @default(1)
  status               StudentStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Data Sekolah Asal
  schoolName     String?
  npsn           String?
  graduationYear String?
  major          String?

  // Data Orang Tua / Wali
  fatherName    String?
  fatherPhone   String?
  fatherJob     String?
  fatherIncome  String?
  motherName    String?
  motherPhone   String?
  motherJob     String?
  motherIncome  String?
  guardianName  String?
  guardianPhone String?
  guardianJob   String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram          StudyProgram           @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  advisorLecturer       Lecturer?              @relation("AcademicAdvisor", fields: [advisorLecturerId], references: [id], onDelete: SetNull)
  enrollments           CourseEnrollment[]
  examSeats             ExamSeat[]
  attendanceRecords     AttendanceRecord[]
  admissionApplications AdmissionApplication[]

  // Relasi Master PMB (Ditetapkan saat konversi PMB)
  registrationTypeId String?
  trackId            String?
  classId            String?
  waveId             String?

  registrationType   AdmissionRegistrationType? @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track              AdmissionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass     AdmissionClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  wave               AdmissionBatch?            @relation(fields: [waveId], references: [id], onDelete: SetNull)
  feeAssignments     StudentFeeAssignment[]
  letterRequests     LetterRequest[]
  thesisSupervisions ThesisSupervision[]

  thesisProject         ThesisProject?
  graduationApplication GraduationApplication?

  @@map("students")
}

model AcademicYear {
  id                  String       @id @default(uuid())
  code                String       @unique // e.g. "20261" for 2026/2027 Gasal
  name                String // e.g. "2026/2027"
  semesterType        SemesterType @default(ODD)
  isActive            Boolean      @default(false)
  startDate           DateTime
  endDate             DateTime
  krsStartDate        DateTime?
  krsEndDate          DateTime?
  isKrsOpen           Boolean      @default(true)
  pmbStartDate        DateTime?
  pmbEndDate          DateTime?
  skRektor            String?
  gradeDeadline       String?
  // Jendela waktu dosen boleh mengisi/mengubah nilai -- dipakai menggantikan toggle manual
  // isGradeLocked: kalau keduanya terisi, akses dihitung otomatis dari tanggal hari ini
  // dibanding rentang ini (bukan diklik manual lagi). isGradeLocked tetap disimpan sebagai
  // fallback untuk tahun akademik lama yang belum mengisi tanggal ini.
  gradeInputStartDate DateTime?
  gradeInputEndDate   DateTime?
  isGradeLocked       Boolean      @default(true)
  status              String       @default("Aktif") // Aktif, Arsip, Mendatang
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  enrollments        CourseEnrollment[]
  courseClasses      CourseClass[]
  gradeScaleVersions GradeScaleVersion[]
  assessmentSchemes  AssessmentScheme[]
  thesisSupervisions ThesisSupervision[]

  examSchedules ExamSchedule[]

  @@map("academic_years")
}

model Course {
  id                        String    @id @default(uuid())
  // id_matkul dari Neo Feeder -- kunci paling stabil untuk mencocokkan ulang data saat
  // re-sync, sama seperti feederId di Lecturer/Student.
  feederId                  String?   @unique
  // Pesan error terakhir kalau Push mata kuliah ini ke Feeder gagal -- dikosongkan lagi begitu
  // Push berikutnya untuk mata kuliah ini berhasil.
  feederSyncError           String?   @db.Text
  feederSyncErrorAt         DateTime?
  studyProgramId            String?
  studyProgramName          String?
  facultyCode               String?
  curriculumId              String?
  code                      String    @unique // e.g. "TIF-201"
  name                      String
  sksTeori                  Int       @default(2)
  sksPraktik                Int       @default(0)
  totalSks                  Int       @default(2)
  sks                       Int       @default(3)
  semester                  Int       @default(1)
  type                      String    @default("Wajib Prodi")
  // true untuk kategori mata kuliah lapangan/tugas akhir (Skripsi/TA, KKN, PLP, Kerja Praktik, dst.):
  // SEMUA kelas dari mata kuliah ini otomatis dianggap tanpa jadwal & ruang tetap, dan mahasiswa
  // yang mengambilnya otomatis masuk daftar Bimbingan Tugas Akhir untuk ditetapkan pembimbingnya —
  // BAAK tidak perlu mencentang "Tanpa jadwal tetap" satu-satu tiap kali membuat kelasnya.
  requiresThesisSupervision Boolean   @default(false)
  // Label kategori spesifik saat requiresThesisSupervision true, mis. "Skripsi/TA", "KKN", "PLP",
  // "Kerja Praktik", "Magang" -- murni untuk tampilan/pelaporan, logika jadwal tetap pakai field di atas.
  finalProjectLabel         String?
  coordinator               String?
  status                    String    @default("Aktif")
  description               String?   @db.Text
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  studyProgram       StudyProgram?       @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  curriculum         Curriculum?         @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  enrollments        CourseEnrollment[]
  classes            CourseClass[]
  thesisSupervisions ThesisSupervision[]

  @@map("courses")
}

model CourseClass {
  id                 String    @id @default(uuid())
  // id_kelas_kuliah dari Neo Feeder -- kunci paling stabil untuk mencocokkan ulang data
  // saat re-sync, sama seperti feederId di Lecturer/Student/Course/Curriculum.
  feederId           String?   @unique
  // Pesan error/peringatan terakhir Push kelas ini ke Feeder (kosong bila sukses).
  feederSyncError    String?   @db.Text
  feederSyncErrorAt  DateTime?
  courseId           String
  // Kelas kuliah (mis. Pagi / Sore) yang dilayani jadwal ini; kosong = terbuka untuk semua kelas
  admissionClassId   String?
  academicYearId     String
  className          String // e.g. "TIF-5A"
  // true untuk mata kuliah tanpa jadwal & ruang tetap (Skripsi/TA, KKN, Kerja Praktik, dst.) —
  // day/startTime/endTime diabaikan dan tidak diikutkan pada cek bentrok jadwal.
  isFlexibleSchedule Boolean   @default(false)
  day                String    @default("Senin")
  startTime          String    @default("08:00")
  endTime            String    @default("10:30")
  roomId             String?
  lecturerId         String?
  // Sesi praktikum kelas yang sama (mata kuliah dengan SKS praktik): satu kelas = satu sesi teori + satu sesi
  // praktikum. Mahasiswa yang mengambil kelas ini otomatis mengikuti keduanya. Kosong = belum dijadwalkan.
  // practiceLecturerId kosong berarti sesi praktikum diampu dosen kelas yang sama.
  practiceDay        String?
  practiceStartTime  String?
  practiceEndTime    String?
  practiceRoomId     String?
  practiceLecturerId String?
  quota              Int       @default(40)
  status             String    @default("Berjalan")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  room               Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  lecturer           Lecturer?           @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  practiceRoom       Room?               @relation("PracticeRoom", fields: [practiceRoomId], references: [id], onDelete: SetNull)
  practiceLecturer   Lecturer?           @relation("PracticeLecturer", fields: [practiceLecturerId], references: [id], onDelete: SetNull)
  enrollments        CourseEnrollment[]
  attendanceSessions AttendanceSession[]
  contract           CourseContract?
  examSchedules      ExamSchedule[]

  admissionClass AdmissionClass? @relation(fields: [admissionClassId], references: [id], onDelete: SetNull)

  @@index([admissionClassId])
  @@unique([courseId, academicYearId, className])
  @@map("course_classes")
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALFA
}

model AttendanceSession {
  id            String   @id @default(uuid())
  courseClassId String
  meetingNumber Int
  date          DateTime
  topic         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courseClass CourseClass        @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]

  @@unique([courseClassId, meetingNumber])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus @default(ALFA)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  session AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
  @@map("attendance_records")
}

model CourseContract {
  id                       String    @id @default(uuid())
  courseClassId            String    @unique
  // Identitas dokumen RPS (format SN-Dikti)
  rpsCode                  String? // Kode/Nomor Dokumen RPS
  description              String?   @db.Text // Deskripsi singkat mata kuliah
  // CPL & CPMK
  graduateLearningOutcomes String?   @db.Text // CPL-Prodi yang dibebankan pada MK
  learningOutcomes         String?   @db.Text // CPMK (Capaian Pembelajaran Mata Kuliah)
  subCpmk                  String?   @db.Text // Sub-CPMK (kemampuan akhir tiap tahapan belajar)
  // Materi, metode, penilaian
  studyMaterials           String?   @db.Text // Bahan kajian / pokok bahasan
  teachingMethods          String?   @db.Text // Bentuk & metode pembelajaran
  studentExperience        String?   @db.Text // Pengalaman belajar mahasiswa
  assessmentCriteria       String?   @db.Text // Kriteria & bentuk penilaian (naratif)
  assessmentWeights        Json? // Bobot penilaian numerik (tugas/uts/uas/kehadiran) -- dipakai perhitungan nilai
  // Pustaka & media
  references               String?   @db.Text // Pustaka utama
  supportingReferences     String?   @db.Text // Pustaka pendukung
  learningMedia            String?   @db.Text // Media & perangkat pembelajaran
  // Otorisasi / pengesahan
  coordinatorName          String? // Koordinator bidang/rumpun MK
  headOfProdiName          String? // Ketua Program Studi (Kaprodi)
  preparedDate             DateTime?
  isPublished              Boolean   @default(false)
  // Validasi Penjaminan Mutu (P2M) -- RPS yang dosen "Simpan & Publikasikan" masuk status
  // DIAJUKAN menunggu disahkan P2M; P2M bisa mengesahkan (DISAHKAN) atau minta revisi
  // (PERLU_REVISI) dengan catatan. Terpisah dari isPublished (visibilitas ke mahasiswa).
  p2mStatus                String?   @default("BELUM_DIAJUKAN") // 'BELUM_DIAJUKAN' | 'DIAJUKAN' | 'DISAHKAN' | 'PERLU_REVISI'
  p2mNote                  String?   @db.Text
  p2mValidatedAt           DateTime?
  p2mValidatedBy           String?
  rpsFileUrl               String?
  rpsFileName              String?
  rpsUploadedAt            DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  courseClass CourseClass          @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  weeks       CourseContractWeek[]

  @@map("course_contracts")
}

model CourseContractWeek {
  id                String  @id @default(uuid())
  contractId        String
  weekNumber        Int
  topic             String // Bahan kajian / materi pertemuan
  method            String? // Bentuk & metode pembelajaran
  indicator         String? // Sub-CPMK / kemampuan akhir tahap belajar
  duration          String? // Alokasi waktu (e.g. "2 x 50 menit")
  studentExperience String? @db.Text // Pengalaman belajar mahasiswa
  assessmentWeight  String? // Kriteria & bobot penilaian pertemuan ini

  contract CourseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, weekNumber])
  @@map("course_contract_weeks")
}

model CourseEnrollment {
  id                   String           @id @default(uuid())
  studentId            String
  courseId             String
  courseClassId        String?
  academicYearId       String
  status               EnrollmentStatus @default(SUBMITTED)
  assignmentScore      Float? // Nilai Tugas
  midtermScore         Float? // Nilai UTS
  finalScore           Float? // Nilai UAS
  totalScore           Float? // Nilai Akhir Angka
  gradeLetter          String? // e.g. "A", "B+", "B"
  gradePoint           Float? // e.g. 4.0, 3.5, 3.0
  gradeStatus          String           @default("DRAFT") // "DRAFT" | "FINAL"
  // Terisi saat baris KRS ini tercatat sinkron dengan Feeder (hasil Pull/Sync dari Feeder,
  // atau nanti Push ke Feeder). Null = belum pernah terkonfirmasi ada di Feeder.
  feederSyncedAt       DateTime?
  // Terisi saat nilai (angka/huruf/indeks) baris ini cocok dengan nilai di Feeder -- diisi
  // oleh sinkronisasi Nilai Perkuliahan dari Feeder. Null = nilai belum terkonfirmasi di Feeder.
  feederGradeSyncedAt  DateTime?
  // Error terakhir Push KRS / Push Nilai baris ini ke Feeder (kosong bila sukses).
  feederSyncError      String?          @db.Text
  feederGradeSyncError String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseClass  CourseClass? @relation(fields: [courseClassId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  componentScores EnrollmentComponentScore[]

  @@unique([studentId, courseId, academicYearId])
  @@unique([studentId, courseClassId])
  @@map("course_enrollments")
}

