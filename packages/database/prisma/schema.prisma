// ==============================================================================
// ATURAN TANDA TANGAN DOKUMEN (DYNAMIC DOCUMENT SIGNATORY RULES)
// Siapa yang menandatangani tiap jenis dokumen resmi (KRS, KHS, surat, dst.) --
// dikelola dinamis oleh Super Admin, bukan ditulis tetap per halaman dokumen.
// ==============================================================================

enum SignerRole {
  DOSEN_PA // Dosen Pembimbing Akademik mahasiswa ybs
  KAPRODI // Ketua Program Studi mahasiswa ybs (StudyProgram.headOfProgram)
  DEKAN // Dekan fakultas mahasiswa ybs (Faculty.deanName)
  WAKIL_REKTOR_AKADEMIK // Wakil Rektor Bidang Akademik (profil institusi)
  REKTOR // Rektor (profil institusi)
}

model DocumentSignatureRule {
  id            String      @id @default(uuid())
  documentCode  String      @unique // kode bebas: 'KRS', 'KHS', 'SURAT_SKAK', dst.
  documentLabel String
  signer1Role   SignerRole  @default(DOSEN_PA)
  signer1Label  String? // label jabatan kustom; kosong = label baku per peran
  signer2Role   SignerRole?
  signer2Label  String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("document_signature_rules")
}

// ==============================================================================
// LAYANAN SURAT MAHASISWA (STUDENT LETTER REQUESTS)
// ==============================================================================

enum LetterRequestStatus {
  MENUNGGU_PA // menunggu verifikasi Dosen Pembimbing Akademik
  DIPROSES_BAAK // disetujui PA (atau tidak perlu PA), sedang diproses BAAK
  SELESAI // surat sudah terbit, siap diunduh
  DITOLAK // ditolak PA atau BAAK
}

model LetterRequest {
  id                      String              @id @default(uuid())
  requestNo               String              @unique // nomor tiket pengajuan (dibuat saat submit)
  letterNo                String? // nomor surat resmi, diisi saat status SELESAI
  typeCode                String // kode katalog: SKAK, SKP, SIP, SRB, SKBB, SKBP
  typeName                String // nama lengkap jenis surat (snapshot katalog saat pengajuan)
  purpose                 String              @db.Text
  targetInstitution       String
  targetPerson            String?
  studentNote             String?             @db.Text
  requiresAdvisorApproval Boolean             @default(true)
  status                  LetterRequestStatus @default(MENUNGGU_PA)

  advisorApprovedAt DateTime?
  advisorNote       String?   @db.Text

  processedAt      DateTime?
  processedByEmail String?
  letterBody       String?   @db.Text

  rejectionReason String? @db.Text
  rejectedBy      String? // 'ADVISOR' | 'BAAK'

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("letter_requests")
}

// ==============================================================================
// BIMBINGAN SKRIPSI / TUGAS AKHIR (KKN, KERJA PRAKTIK, DST.)
// Penetapan pembimbing per mahasiswa oleh Admin Akademik (BAAK) — berbeda dari
// Dosen Pembimbing Akademik (PA) di Student.advisorLecturerId, dan berbeda dari
// "Dosen Pengampu" di CourseClass yang mewakili satu kelas untuk banyak mahasiswa.
// ==============================================================================
model ThesisSupervision {
  id             String    @id @default(uuid())
  studentId      String
  courseId       String
  academicYearId String
  title          String?   @db.Text // judul skripsi/kegiatan, opsional & bisa menyusul
  supervisor1Id  String?
  supervisor2Id  String?
  notes          String?   @db.Text
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  supervisor1  Lecturer?    @relation("ThesisSupervisor1", fields: [supervisor1Id], references: [id], onDelete: SetNull)
  supervisor2  Lecturer?    @relation("ThesisSupervisor2", fields: [supervisor2Id], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId, academicYearId])
  @@map("thesis_supervisions")
}

model FinanceBankAccount {
  id            String   @id @default(uuid())
  bankName      String
  description   String?
  accountNumber String
  accountName   String
  balance       Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("finance_bank_accounts")
}

model FinanceBudgetItem {
  id           String   @id @default(uuid())
  category     String
  academicYear String   @default("2026/2027")
  allocated    Float    @default(0)
  spent        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("finance_budget_items")
}

// ==============================================================================
// MASTER KOMPONEN BIAYA & ATURAN PEMBIAYAAN (FEE RULES ENGINE)
// ==============================================================================

model FeeComponent {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. "SPP", "SKS", "PRAKTIKUM", "UJIAN", "REGISTRASI", "WISUDA"
  name          String // e.g. "SPP / Uang Kuliah Tunggal", "Biaya SKS Perkuliahan"
  defaultAmount Float // Tarif dasar standar (Rp)
  category      String   @default("SEMESTER") // "SEMESTER", "PER_SKS", "SEKALI_BAYAR"
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleItems    FeeRuleItem[]
  invoiceItems PaymentInvoiceItem[]

  @@map("fee_components")
}

enum FeeRuleBillingMode {
  UKT
  PER_SKS
}

model FeeRule {
  id           String             @id @default(uuid())
  name         String // e.g. "Aturan Beasiswa KIP-Kuliah"
  code         String             @unique // e.g. "RULE_KIP"
  description  String?            @db.Text
  priority     Int                @default(10) // Prioritas: angka makin besar makin prioritas
  academicYear String? // null = berlaku untuk semua tahun akademik
  billingMode  FeeRuleBillingMode @default(UKT) // UKT = flat per semester, PER_SKS = tarif x SKS diambil
  isActive     Boolean            @default(true)

  // Kondisi opsional pencocokan rule
  registrationTypeId String?
  trackId            String?
  classId            String?
  studyProgramId     String?
  waveId             String?

  registrationType AdmissionRegistrationType? @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track            AdmissionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass   AdmissionClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  studyProgram     StudyProgram?              @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  wave             AdmissionBatch?            @relation(fields: [waveId], references: [id], onDelete: SetNull)

  ruleItems   FeeRuleItem[]
  assignments StudentFeeAssignment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("fee_rules")
}

model FeeRuleItem {
  id             String   @id @default(uuid())
  feeRuleId      String
  feeComponentId String
  actionType     String   @default("NORMAL") // "NORMAL", "BEBAS", "DISKON_PERSENTASE", "DISKON_NOMINAL", "TARIF_KHUSUS"
  amountValue    Float? // Nilai diskon persen / diskon nominal / tarif khusus
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeRule      FeeRule      @relation(fields: [feeRuleId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent @relation(fields: [feeComponentId], references: [id], onDelete: Restrict)

  @@unique([feeRuleId, feeComponentId])
  @@map("fee_rule_items")
}

model StudentFeeAssignment {
  id           String   @id @default(uuid())
  studentId    String
  feeRuleId    String?
  academicYear String // e.g. "2026/2027"
  schemeName   String // e.g. "Skema Beasiswa KIP-Kuliah", "Skema Reguler Mandiri"
  snapshotData Json // Snapshot rincian aturan & komponen saat penetapan dilakukan
  notes        String?  @db.Text
  assignedAt   DateTime @default(now())
  assignedBy   String?  @default("SISTEM_PMB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeRule FeeRule? @relation(fields: [feeRuleId], references: [id], onDelete: SetNull)

  @@index([studentId, academicYear])
  @@map("student_fee_assignments")
}

model PaymentInvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  feeComponentId String?
  componentName  String
  baseAmount     Float
  actionType     String   @default("NORMAL") // "NORMAL", "BEBAS", "DISKON_PERSENTASE", "DISKON_NOMINAL", "TARIF_KHUSUS"
  actionValue    Float?
  discountAmount Float    @default(0)
  finalAmount    Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice      PaymentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent?  @relation(fields: [feeComponentId], references: [id], onDelete: SetNull)

  @@map("payment_invoice_items")
}
