model Building {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  alias           String?
  functionDesc    String?
  floorsCount     Int      @default(1)
  roomsCount      Int      @default(0)
  capacity        Int      @default(0)
  picName         String?
  picPhone        String?
  status          String   @default("Aktif Beroperasi")
  establishedYear Int      @default(2020)
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms Room[]

  @@map("buildings")
}

model Room {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  buildingId   String
  buildingCode String
  buildingName String
  floor        Int      @default(1)
  type         String   @default("Kelas Teori")
  capacity     Int      @default(40)
  facilities   String[] @default([])
  status       String   @default("Tersedia")
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  building        Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  courseClasses   CourseClass[]
  practiceClasses CourseClass[] @relation("PracticeRoom")

  examSchedules ExamSchedule[]

  @@map("rooms")
}

model CalendarEvent {
  id           String   @id @default(uuid())
  title        String
  category     String   @default("Perkuliahan")
  startDate    String
  endDate      String
  academicYear String   @default("2026/2027")
  semester     String   @default("Gasal") // Gasal, Genap, Pendek
  target       String   @default("Seluruh Mahasiswa & Dosen")
  status       String   @default("Akan Datang") // Berlangsung, Akan Datang, Selesai
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("calendar_events")
}

model GradeScaleVersion {
  id             String   @id @default(uuid())
  academicYearId String? // Grup skala ini berlaku untuk tahun akademik/semester yang mana
  label          String? // Label tampilan opsional, default dari nama tahun akademik
  createdAt      DateTime @default(now())

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  scales       GradeScale[]

  @@map("grade_scale_versions")
}

model GradeScale {
  id         String   @id @default(uuid())
  versionId  String
  letter     String // e.g. "A", "A-", "B+"
  minScore   Float // Batas bawah nilai angka (inklusif)
  maxScore   Float // Batas atas nilai angka (inklusif)
  gradePoint Float // Bobot untuk perhitungan IPK, e.g. 4.0, 3.7
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  version GradeScaleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, letter])
  @@map("grade_scales")
}

model Curriculum {
  id                String    @id @default(uuid())
  // id_kurikulum dari Neo Feeder -- kunci paling stabil untuk mencocokkan ulang data saat
  // re-sync, sama seperti feederId di Lecturer/Student/Course.
  feederId          String?   @unique
  // Pesan error terakhir kalau Push kurikulum ini ke Feeder gagal -- dikosongkan lagi begitu
  // Push berikutnya untuk kurikulum ini berhasil.
  feederSyncError   String?   @db.Text
  feederSyncErrorAt DateTime?
  code              String    @unique
  name              String
  studyProgram      String
  degreeLevel       String    @default("S1")
  facultyCode       String    @default("FASILKOM")
  startYear         Int       @default(2024)
  sksWajib          Int       @default(120)
  sksPilihan        Int       @default(24)
  totalSks          Int       @default(144)
  curriculumType    String    @default("Kurikulum OBE")
  skRektor          String?
  status            String    @default("Aktif")
  description       String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  courses Course[]

  @@map("curriculums")
}

// ==============================================================================
// LP3M (LEMBAGA PENELITIAN & PENGABDIAN KEPADA MASYARAKAT) MODELS
// ==============================================================================

