datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN_BAAK
  ADMIN_KEUANGAN
  ADMIN_LP3M
  LP3M
  LECTURER
  STUDENT
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  LEAVE
  GRADUATED
  DROPOUT
  TRANSFERRED
}

enum SemesterType {
  ODD
  EVEN
  SHORT
}

enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DegreeLevel {
  D3
  D4
  S1
  S2
  S3
  PROFESI
}

enum AdmissionStatus {
  PENDING
  VERIFIED
  PASSED
  FAILED
  REGISTERED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student                     Student?
  lecturer                    Lecturer?
  updatedLandingPageSettings  LandingPageSetting[]
  landingPageArticles         LandingPageArticle[]

  @@map("users")
}

model Faculty {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  deanName      String?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  studyPrograms StudyProgram[]

  @@map("faculties")
}

model StudyProgram {
  id                  String       @id @default(uuid())
  facultyId           String
  code                String       @unique
  diktiCode           String?
  name                String
  degreeLevel         DegreeLevel  @default(S1)
  degreeTitle         String?
  accreditation       String       @default("Unggul")
  accreditationAgency String?      @default("BAN-PT / LAM")
  skAkreditasi        String?
  headOfProgram       String?
  headNip             String?
  status              String       @default("Aktif")
  studentsCount       Int          @default(0)
  lecturersCount      Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  faculty       Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students      Student[]
  lecturers     Lecturer[]
  courses       Course[]

  @@map("study_programs")
}

model Lecturer {
  id                String       @id @default(uuid())
  userId            String       @unique
  studyProgramId    String
  nidn              String       @unique
  nip               String?      @unique
  titlePrefix       String?
  titleSuffix       String?
  phone             String?
  isAcademicAdvisor Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram      StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  advisedStudents   Student[]    @relation("AcademicAdvisor")

  @@map("lecturers")
}

model Student {
  id                String             @id @default(uuid())
  userId            String             @unique
  studyProgramId    String
  advisorLecturerId String?
  nim               String             @unique
  gender            Gender             @default(MALE)
  birthDate         DateTime?
  birthPlace        String?
  phone             String?
  nik               String?
  address           String?            @db.Text
  entryYear         Int
  currentSemester   Int                @default(1)
  status            StudentStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram      StudyProgram       @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  advisorLecturer   Lecturer?          @relation("AcademicAdvisor", fields: [advisorLecturerId], references: [id], onDelete: SetNull)
  enrollments       CourseEnrollment[]

  @@map("students")
}

model AcademicYear {
  id           String             @id @default(uuid())
  code         String             @unique // e.g. "20261" for 2026/2027 Gasal
  name         String             // e.g. "2026/2027"
  semesterType SemesterType       @default(ODD)
  isActive     Boolean            @default(false)
  startDate    DateTime
  endDate      DateTime
  krsStartDate DateTime?
  krsEndDate   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  enrollments  CourseEnrollment[]

  @@map("academic_years")
}

model Course {
  id               String             @id @default(uuid())
  studyProgramId   String?
  studyProgramName String?
  facultyCode      String?
  code             String             @unique // e.g. "TIF-201"
  name             String
  sksTeori         Int                @default(2)
  sksPraktik       Int                @default(0)
  totalSks         Int                @default(2)
  sks              Int                @default(3)
  semester         Int                @default(1)
  type             String             @default("Wajib Prodi")
  coordinator      String?
  status           String             @default("Aktif")
  description      String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studyProgram     StudyProgram?      @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  enrollments      CourseEnrollment[]

  @@map("courses")
}

model CourseEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  courseId       String
  academicYearId String
  status         EnrollmentStatus @default(SUBMITTED)
  midtermScore   Float?           // Nilai UTS
  finalScore     Float?           // Nilai UAS
  totalScore     Float?           // Nilai Akhir Angka
  gradeLetter    String?          // e.g. "A", "B+", "B"
  gradePoint     Float?           // e.g. 4.0, 3.5, 3.0
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId, academicYearId])
  @@map("course_enrollments")
}

model AdmissionApplicant {
  id                  String          @id @default(uuid())
  registrationNumber  String          @unique // e.g. "PMB20270001"
  fullName            String
  email               String
  phone               String
  highSchool          String
  chosenStudyProgram  String
  jalurPendaftaran    String          @default("Reguler / Mandiri")
  status              AdmissionStatus @default(PENDING)
  testScore           Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@map("admission_applicants")
}

model LandingPageSetting {
  id                    String    @id @default("default-setting")
  campusName            String    @default("Institut Teknologi Nusantara")
  campusShortName       String    @default("ITN")
  tagline               String    @default("Kampus Inovasi Teknologi Masa Depan")
  heroBadge             String    @default("Penerimaan Mahasiswa Baru TA 2026/2027 Telah Dibuka!")
  heroTitle             String    @default("Membentuk Generasi Unggul di Era Transformasi Digital")
  heroSubtitle          String    @default("Institut Teknologi Nusantara (ITN) memadukan keunggulan akademik, riset terapan mutakhir, dan ekosistem industri digital terdepan untuk mencetak profesional dan entrepreneur masa depan.")
  heroCtaText           String    @default("Daftar Sekarang (PMB)")
  heroCtaLink           String    @default("/pmb")
  heroSecondaryCtaText  String    @default("Jelajahi Program Studi")
  heroSecondaryCtaLink  String    @default("/#program-studi")
  
  // Sambutan Rektor
  rectorName            String    @default("Prof. Dr. Ir. Hendra Gunawan, M.Eng.")
  rectorTitle           String    @default("Rektor Institut Teknologi Nusantara")
  rectorQuote           String    @default("Pendidikan di ITN tidak hanya berfokus pada penguasaan teori, tetapi melahirkan solusi nyata bagi bangsa.")
  rectorSpeech          String    @db.Text
  rectorImageUrl        String?
  
  // Pengumuman Banner
  announcementActive    Boolean   @default(true)
  announcementBadge     String    @default("INFO AKADEMIK")
  announcementText      String    @default("Pengisian KRS Semester Ganjil 2026/2027 berlangsung hingga 31 Agustus 2026. Pastikan konsultasi Dosen PA selesai tepat waktu.")
  announcementLink      String?   @default("/portal")

  // Kontak & Lokasi Kampus
  contactAddress        String    @default("Jl. Raya Pendidikan No. 45, Kampus Terpadu, Jakarta Selatan 12430")
  contactPhone          String    @default("(021) 7890-1234")
  contactEmail          String    @default("info@itn.ac.id")
  contactWhatsapp       String    @default("+62 812-3456-7890")
  
  // Media Sosial
  socialInstagram       String?   @default("https://instagram.com/itn_official")
  socialYoutube         String?   @default("https://youtube.com/@itnofficial")
  socialLinkedin        String?   @default("https://linkedin.com/school/itn-official")

  // Identitas & Legalitas Institusi
  foundationName        String    @default("Yayasan Pendidikan Teknologi Nusantara Mandiri")
  website               String    @default("https://itn.ac.id")
  academicEmail         String    @default("baak@itn.ac.id")
  accreditation         String    @default("Unggul")
  accreditationSk       String    @default("No. 1042/SK/BAN-PT/Ak/PT/VIII/2024")
  accreditationValidUntil String  @default("28 Agustus 2029")
  ptStatus              String    @default("Perguruan Tinggi Swasta (Aktif)")
  npsn                  String    @default("061024")
  ptCode                String    @default("071032")
  establishmentYear     Int       @default(1993)
  establishmentSk       String    @default("Kepmendikbud No. 048/D/O/1993")
  activeSemester        String    @default("Semester Gasal")
  activeAcademicYear    String    @default("2026/2027")

  // Pimpinan Perguruan Tinggi
  viceRector1           String    @default("Dr. Ir. Hendra Gunawan, M.T. (Bid. Akademik & Riset)")
  viceRector2           String    @default("Dra. Hj. Sri Wahyuni, M.M., Ak. (Bid. Keuangan & SDM)")
  viceRector3           String    @default("Dr. Rian Hidayat, S.Kom., M.Kom. (Bid. Kemahasiswaan & Kerjasama)")
  logoInitials          String    @default("ITN")
  logoUrl               String?

  // Identitas Visual, Kop Dokumen & Format Penomoran
  primaryColor          String    @default("#1E3A8A")
  accentColor           String    @default("#D4A017")
  themeName             String    @default("Nusantara Navy & Gold")
  kopLine1              String    @default("Yayasan Pendidikan Teknologi Nusantara Mandiri")
  kopLine2              String    @default("INSTITUT TEKNOLOGI NUSANTARA")
  kopContact            String    @default("Jl. DI Panjaitan No. 128, Jakarta Selatan 12340 | Telp: (021) 7888-9900 | Email: baak@itn.ac.id")
  pinFormat             String    @default("{KODE_PT}-{TAHUN}-{PRODI}-{NO_URUT}")
  nomorSuratFormat      String    @default("{NO}/ITN-BAAK/{BULAN_ROMAWI}/{TAHUN}")
  nimFormat             String    @default("{ANGKATAN_2DIGIT}{KODE_PRODI_3DIGIT}{NO_URUT_4DIGIT}")
  doubleBorderKop       Boolean   @default(true)

  updatedByUserId       String?
  updatedByUser         User?     @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("landing_page_settings")
}

model LandingPageArticle {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  category    String    @default("Akademik")
  excerpt     String    @db.Text
  content     String    @db.Text
  imageUrl    String?
  authorId    String?
  authorName  String    @default("Humas ITN")
  readTime    String    @default("4 min read")
  isFeatured  Boolean   @default(false)
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("landing_page_articles")
}

model LandingPageFeature {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  iconName    String   @default("Sparkles")
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_page_features")
}

model VisitorLog {
  id        String   @id @default(uuid())
  path      String   @default("/")
  ip        String?
  userAgent String?
  device    String   @default("Desktop") // "Mobile", "Desktop", "Tablet"
  referer   String?  @default("Direct")  // "Google", "Instagram", "Direct", "Referral", etc.
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@map("visitor_logs")
}

model SystemAuditLog {
  id        String   @id @default(uuid())
  action    String
  detail    String
  userEmail String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_audit_logs")
}

model Building {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  alias           String?
  functionDesc    String?
  floorsCount     Int      @default(1)
  roomsCount      Int      @default(0)
  capacity        Int      @default(0)
  picName         String?
  picPhone        String?
  status          String   @default("Aktif Beroperasi")
  establishedYear Int      @default(2020)
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms           Room[]

  @@map("buildings")
}

model Room {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  buildingId      String
  buildingCode    String
  buildingName    String
  floor           Int      @default(1)
  type            String   @default("Kelas Teori")
  capacity        Int      @default(40)
  facilities      String[] @default([])
  status          String   @default("Tersedia")
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model CalendarEvent {
  id           String   @id @default(uuid())
  title        String
  category     String   @default("Perkuliahan")
  startDate    String
  endDate      String
  academicYear String   @default("2026/2027")
  semester     String   @default("Gasal") // Gasal, Genap, Pendek
  target       String   @default("Seluruh Mahasiswa & Dosen")
  status       String   @default("Akan Datang") // Berlangsung, Akan Datang, Selesai
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("calendar_events")
}

model Curriculum {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  studyProgram   String
  degreeLevel    String   @default("S1")
  facultyCode    String   @default("FASILKOM")
  startYear      Int      @default(2024)
  sksWajib       Int      @default(120)
  sksPilihan     Int      @default(24)
  totalSks       Int      @default(144)
  curriculumType String   @default("Kurikulum OBE")
  skRektor       String?
  status         String   @default("Aktif")
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("curriculums")
}

model SemesterPeriod {
  id                  String   @id @default(uuid())
  code                String   @unique // e.g. "20261"
  name                String
  academicYear        String
  type                String   @default("Gasal") // Gasal, Genap, Pendek
  startDate           String
  endDate             String
  krsStartDate        String
  krsEndDate          String
  gradeDeadline       String
  totalCoursesOffered Int      @default(0)
  totalCreditsOffered Int      @default(0)
  isActive            Boolean  @default(false)
  isGradeLocked       Boolean  @default(true)
  status              String   @default("Buka") // Buka, Masa Ujian, Terkunci, Selesai
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("semester_periods")
}

model AcademicYearPeriod {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. "2026"
  yearName           String   // e.g. "2026/2027"
  startDate          String
  endDate            String
  pmbStartDate       String
  pmbEndDate         String
  semestersAvailable String[] @default(["Gasal", "Genap", "Pendek"])
  studentsCount      Int      @default(0)
  skRektor           String?
  isActive           Boolean  @default(false)
  status             String   @default("Aktif") // Aktif, Arsip, Mendatang
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("academic_year_periods")
}

// ==============================================================================
// LP3M (LEMBAGA PENELITIAN & PENGABDIAN KEPADA MASYARAKAT) MODELS
// ==============================================================================

model Lp3mResearch {
  id              String   @id @default(uuid())
  code            String?  @unique
  type            String   // 'Penelitian' | 'Pengabdian'
  title           String
  scheme          String   // e.g. 'Penelitian Fundamental Internal'
  focusArea       String   // e.g. 'Kecerdasan Buatan & Kesehatan Digital'
  leader          String
  nidn            String?
  faculty         String
  studyProgram    String?
  membersCount    Int      @default(1)
  year            Int      @default(2026)
  fundingAmount   Float    @default(0)
  fundingSource   String   @default("DIPA Internal")
  status          String   @default("Menunggu Verifikasi") // 'Sedang Berjalan' | 'Selesai' | 'Menunggu Verifikasi' | 'Revisi Usulan' | 'Ditolak'
  targetOutput    String?
  mitraSasaran    String?
  reviewerNote    String?  @db.Text
  documentUrl     String?
  submittedAt     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("lp3m_researches")
}

model Lp3mIntellectualProperty {
  id              String   @id @default(uuid())
  regNumber       String   @unique
  title           String
  type            String   // 'Hak Cipta' | 'Paten Sederhana' | 'Paten Biasa' | 'Desain Industri'
  inventor        String
  nidn            String?
  faculty         String
  status          String   @default("Menunggu Verifikasi") // 'Tersertifikasi' | 'Pemeriksaan Substantif' | 'Menunggu Verifikasi'
  certificateUrl  String?
  grantYear       Int      @default(2026)
  applicationDate String?
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("lp3m_intellectual_properties")
}

model Lp3mDocument {
  id             String   @id @default(uuid())
  code           String   @unique
  title          String
  category       String   // 'Panduan & Renstra' | 'Regulasi & SK Rektor' | 'Template Proposal' | 'Instrumen Borang'
  fileType       String   @default("PDF") // 'PDF' | 'DOCX' | 'XLSX' | 'ZIP'
  fileSize       String   @default("1.0 MB")
  version        String   @default("v2026.1")
  academicYear   String   @default("2026")
  accessLevel    String   @default("Publik") // 'Publik' | 'Dosen & Reviewer' | 'Khusus Tim LP3M'
  description    String?  @db.Text
  author         String   @default("LP3M ITN")
  fileUrl        String?
  downloadsCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("lp3m_documents")
}

model Lp3mBorangRecord {
  id                      String   @id @default(uuid())
  prodiCode               String   @unique
  prodiName               String
  faculty                 String
  academicYear            String   @default("2026")
  dtpsCount               Int      @default(0)
  penelitianLokal         Int      @default(0)
  penelitianNasional      Int      @default(0)
  penelitianInternasional Int      @default(0)
  danaPenelitianTotal     Float    @default(0)
  pkmLokal                Int      @default(0)
  pkmNasional             Int      @default(0)
  pkmInternasional        Int      @default(0)
  danaPkmTotal            Float    @default(0)
  scopusCount             Int      @default(0)
  sintaCount              Int      @default(0)
  hakiCount               Int      @default(0)
  bukuCount               Int      @default(0)
  scorePenelitian         Float    @default(0)
  scorePkm                Float    @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("lp3m_borang_records")
}

