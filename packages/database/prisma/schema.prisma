  @@index([createdAt])
  @@index([path])
  @@map("visitor_logs")
}

model SystemAuditLog {
  id        String   @id @default(uuid())
  action    String
  detail    String
  userEmail String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_audit_logs")
}

model Building {
