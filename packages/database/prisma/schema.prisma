/// Jenis mahasiswa menurut sistem (berbeda dari nama/kode buatan kampus): dipakai untuk aturan NIM, pelaporan, dsb.
enum AdmissionTrackKind {
  BARU // Peserta didik baru
  TRANSFER // Pindahan
  RPL // lama: RPL tanpa varian; diperlakukan sebagai RPL Perolehan SKS, pilih ulang varian yang tepat
  RPL_PEROLEHAN // RPL Perolehan SKS
  RPL_TRANSFER // RPL Transfer SKS
  NON_GELAR // Pendidikan Non Gelar (Course)
  FAST_TRACK // Fast Track
  PPG_PGP // PPG PGP / PLPG
  PPG_NON_PGP // PPG Non PGP / PLPG
  DOUBLE_DEGREE // Double Degree
  JOIN_DEGREE // Join Degree
}

model AdmissionTrack {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "REGULER", "TRANSFER", "PRESTASI", "KIPK"
