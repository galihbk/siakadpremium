datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN_BAAK
  ADMIN_PMB
  ADMIN_KEUANGAN
  ADMIN_LP3M
  LP3M
  LECTURER
  STUDENT
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  LEAVE
  GRADUATED
  DROPOUT
  TRANSFERRED
}

enum SemesterType {
  ODD
  EVEN
  SHORT
}

enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DegreeLevel {
  D3
  D4
  S1
  S2
  S3
  PROFESI
}

enum AdmissionStatus {
  PENDING
  VERIFIED
  PASSED
  FAILED
  REGISTERED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student                     Student?
  lecturer                    Lecturer?
  updatedLandingPageSettings  LandingPageSetting[]
  landingPageArticles         LandingPageArticle[]

  @@map("users")
}

model Faculty {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  deanName      String?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  studyPrograms StudyProgram[]

  @@map("faculties")
}

model StudyProgram {
  id                  String       @id @default(uuid())
  facultyId           String
  code                String       @unique
  diktiCode           String?
  name                String
  degreeLevel         DegreeLevel  @default(S1)
  degreeTitle         String?
  accreditation       String       @default("Unggul")
  accreditationAgency String?      @default("BAN-PT / LAM")
  skAkreditasi        String?
  headOfProgram       String?
  headNip             String?
  status              String       @default("Aktif")
  studentsCount       Int          @default(0)
  lecturersCount      Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  faculty       Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students      Student[]
  lecturers     Lecturer[]
  courses       Course[]
  admissionApplications AdmissionApplication[]
  feeRules              FeeRule[]

  @@map("study_programs")
}

model Lecturer {
  id                String       @id @default(uuid())
  userId            String       @unique
  studyProgramId    String
  nidn              String       @unique
  nip               String?      @unique
  titlePrefix       String?
  titleSuffix       String?
  phone             String?
  isAcademicAdvisor Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram      StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  advisedStudents   Student[]    @relation("AcademicAdvisor")
  courseClasses     CourseClass[]

  @@map("lecturers")
}

model Student {
  id                String             @id @default(uuid())
  userId            String             @unique
  studyProgramId    String
  advisorLecturerId String?
  nim               String             @unique
  gender            Gender             @default(MALE)
  birthDate         DateTime?
  birthPlace        String?
  phone             String?
  nik               String?
  nisn              String?
  noKk              String?
  address           String?            @db.Text
  streetAddress     String?            @db.Text
  rtRw              String?
  dusun             String?
  kelurahan         String?
  kecamatan         String?
  city              String?
  province          String?
  postalCode        String?
  religion          String?
  entryYear         Int
  currentSemester   Int                @default(1)
  status            StudentStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Data Sekolah Asal
  schoolName        String?
  npsn              String?
  graduationYear    String?
  major             String?

  // Data Orang Tua / Wali
  fatherName        String?
  fatherPhone       String?
  fatherJob         String?
  fatherIncome      String?
  motherName        String?
  motherPhone       String?
  motherJob         String?
  motherIncome      String?
  guardianName      String?
  guardianPhone     String?
  guardianJob       String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram      StudyProgram       @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  advisorLecturer   Lecturer?          @relation("AcademicAdvisor", fields: [advisorLecturerId], references: [id], onDelete: SetNull)
  enrollments       CourseEnrollment[]
  attendanceRecords AttendanceRecord[]
  admissionApplications AdmissionApplication[]

  // Relasi Master PMB (Ditetapkan saat konversi PMB)
  registrationTypeId String?
  trackId            String?
  classId            String?
  waveId             String?

  registrationType   AdmissionRegistrationType? @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track              AdmissionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass     AdmissionClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  wave               AdmissionBatch?            @relation(fields: [waveId], references: [id], onDelete: SetNull)
  feeAssignments     StudentFeeAssignment[]

  @@map("students")
}


model AcademicYear {
  id           String             @id @default(uuid())
  code         String             @unique // e.g. "20261" for 2026/2027 Gasal
  name         String             // e.g. "2026/2027"
  semesterType SemesterType       @default(ODD)
  isActive     Boolean            @default(false)
  startDate    DateTime
  endDate      DateTime
  krsStartDate DateTime?
  krsEndDate   DateTime?
  isKrsOpen    Boolean            @default(true)
  pmbStartDate DateTime?
  pmbEndDate   DateTime?
  skRektor     String?
  gradeDeadline String?
  isGradeLocked Boolean           @default(true)
  status       String             @default("Aktif") // Aktif, Arsip, Mendatang
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  enrollments  CourseEnrollment[]
  courseClasses CourseClass[]
  gradeScaleVersions GradeScaleVersion[]

  @@map("academic_years")
}

model Course {
  id               String             @id @default(uuid())
  studyProgramId   String?
  studyProgramName String?
  facultyCode      String?
  curriculumId     String?
  code             String             @unique // e.g. "TIF-201"
  name             String
  sksTeori         Int                @default(2)
  sksPraktik       Int                @default(0)
  totalSks         Int                @default(2)
  sks              Int                @default(3)
  semester         Int                @default(1)
  type             String             @default("Wajib Prodi")
  coordinator      String?
  status           String             @default("Aktif")
  description      String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studyProgram     StudyProgram?      @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  curriculum       Curriculum?        @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  enrollments      CourseEnrollment[]
  classes          CourseClass[]

  @@map("courses")
}

model CourseClass {
  id             String   @id @default(uuid())
  courseId       String
  academicYearId String
  className      String   // e.g. "TIF-5A"
  day            String   @default("Senin")
  startTime      String   @default("08:00")
  endTime        String   @default("10:30")
  roomId         String?
  lecturerId     String?
  quota          Int      @default(40)
  status         String   @default("Berjalan")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  room           Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  lecturer       Lecturer?          @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  enrollments    CourseEnrollment[]
  attendanceSessions AttendanceSession[]
  contract       CourseContract?

  @@unique([courseId, academicYearId, className])
  @@map("course_classes")
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALFA
}

model AttendanceSession {
  id            String   @id @default(uuid())
  courseClassId String
  meetingNumber Int
  date          DateTime
  topic         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courseClass   CourseClass        @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  records       AttendanceRecord[]

  @@unique([courseClassId, meetingNumber])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus @default(ALFA)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  session AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId])
  @@map("attendance_records")
}

model CourseContract {
  id                String   @id @default(uuid())
  courseClassId     String   @unique
  description       String?  @db.Text
  learningOutcomes  String?  @db.Text
  references        String?  @db.Text
  assessmentWeights Json?
  isPublished       Boolean  @default(false)
  rpsFileUrl        String?
  rpsFileName       String?
  rpsUploadedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  courseClass CourseClass          @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  weeks       CourseContractWeek[]

  @@map("course_contracts")
}

model CourseContractWeek {
  id         String  @id @default(uuid())
  contractId String
  weekNumber Int
  topic      String
  method     String?
  indicator  String?

  contract CourseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, weekNumber])
  @@map("course_contract_weeks")
}

model CourseEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  courseId       String
  courseClassId  String?
  academicYearId String
  status         EnrollmentStatus @default(SUBMITTED)
  assignmentScore Float?          // Nilai Tugas
  midtermScore   Float?           // Nilai UTS
  finalScore     Float?           // Nilai UAS
  totalScore     Float?           // Nilai Akhir Angka
  gradeLetter    String?          // e.g. "A", "B+", "B"
  gradePoint     Float?           // e.g. 4.0, 3.5, 3.0
  gradeStatus    String           @default("DRAFT") // "DRAFT" | "FINAL"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseClass    CourseClass?     @relation(fields: [courseClassId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId, academicYearId])
  @@unique([studentId, courseClassId])
  @@map("course_enrollments")
}

model PmbAccount {
  id              String                 @id @default(uuid())
  fullName        String
  email           String                 @unique
  whatsapp        String
  passwordHash    String
  isEmailVerified Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  applications    AdmissionApplication[]

  @@map("pmb_accounts")
}

model AdmissionBatch {
  id           String                 @id @default(uuid())
  name         String                 // e.g. "Gelombang 1"
  academicYear String                 @default("2027/2028")
  jenjang      String                 @default("S1")
  startDate    String                 // e.g. "2026-08-01"
  endDate      String                 // e.g. "2026-11-30"
  status            String                 @default("OPEN") // "OPEN", "UPCOMING", "CLOSED"
  quota             Int?                   @default(100)
  registrationFee   Float?                 @default(250000)
  reRegistrationFee Float?                 @default(7300000)
  description       String?                @db.Text
  isDefault         Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  applications AdmissionApplication[]
  students     Student[]
  feeRules     FeeRule[]

  @@map("admission_batches")
}

model PmbFeeConfig {
  id                String   @id @default(uuid())
  jenjang           String   @default("SEMUA")
  registrationFee   Float    @default(250000)
  reRegistrationFee Float    @default(7300000)
  description       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pmb_fee_configs")
}

model AdmissionRegistrationType {
  id          String                 @id @default(uuid())
  code        String                 @unique // e.g. "NON_KIP", "KIPK", "MITRA"
  name        String                 // e.g. "NON-KIP (Reguler Mandiri)", "KIP-Kuliah (Beasiswa)"
  description String?                @db.Text
  badge       String?                // e.g. "Beasiswa Penuh", "Umum Mandiri"
  isKip       Boolean                @default(false)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  applications AdmissionApplication[]
  students     Student[]
  feeRules     FeeRule[]

  @@map("admission_registration_types")
}

model AdmissionTrack {
  id          String                 @id @default(uuid())
  code        String                 @unique // e.g. "REGULER", "TRANSFER", "PRESTASI", "KIPK"
  name        String                 // e.g. "Jalur Reguler", "Jalur Prestasi", "Jalur KIP-Kuliah"
  description String?                @db.Text
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  applications AdmissionApplication[]
  students     Student[]
  feeRules     FeeRule[]

  @@map("admission_tracks")
}

model AdmissionClass {
  id          String                 @id @default(uuid())
  code        String                 @unique // e.g. "REGULER", "KARYAWAN"
  name        String                 // e.g. "Kelas Reguler (Pagi)", "Kelas Karyawan (Sore/Malam)"
  description String?                @db.Text
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  applications AdmissionApplication[]
  students     Student[]
  feeRules     FeeRule[]

  @@map("admission_classes")
}

model AdmissionApplication {
  id                 String             @id @default(uuid())
  accountId          String
  waveId             String?
  registrationTypeId String?
  trackId            String?
  classId            String?
  studyProgramId     String?
  isKip              Boolean            @default(false)

  // Nomor Pendaftaran dibuat HANYA saat status = SUBMITTED
  registrationNumber String?            @unique // e.g. "PMB-2027-000123"

  // Status Alur PMB
  formStatus         String             @default("DRAFT") // "DRAFT", "SUBMITTED"
  verificationStatus String             @default("UNVERIFIED") // "UNVERIFIED", "VERIFIED", "REJECTED"
  verificationNote   String?            @db.Text
  verifiedAt         DateTime?
  verifiedBy         String?

  selectionStatus    String             @default("PENDING_SELECTION") // "PENDING_SELECTION", "PASSED", "FAILED", "RESERVE"
  testScore          Float?
  selectionNotes     String?            @db.Text
  selectionDate      DateTime?

  // Data Pribadi
  nik                String?
  fullName           String
  birthPlace         String?
  birthDate          String?
  gender             String?
  religion           String?
  phone              String
  email              String
  address            String?            @db.Text
  streetAddress      String?            @db.Text
  rtRw               String?
  dusun              String?
  kelurahan          String?
  kecamatan          String?
  city               String?
  province           String?
  postalCode         String?

  // Data Sekolah / Riwayat Pendidikan
  schoolName         String?
  npsn               String?
  nisn               String?
  graduationYear     String?
  major              String?

  // Orang Tua / Wali
  parentName         String?
  parentPhone        String?
  parentJob          String?
  parentIncome       String?
  fatherName         String?
  fatherPhone        String?
  fatherJob          String?
  fatherIncome       String?
  motherName         String?
  motherPhone        String?
  motherJob          String?
  motherIncome       String?

  // Berkas Dokumen
  fileKtp            String?
  fileKk             String?
  fileIjazah         String?
  fileFoto           String?
  fileKip            String?
  fileTambahan       String?

  // Hubungan dengan Mahasiswa Resmi (jika sudah daftar ulang lunas & dikonversi)
  studentId          String?
  nim                String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  account            PmbAccount                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wave               AdmissionBatch?             @relation(fields: [waveId], references: [id], onDelete: SetNull)
  registrationType   AdmissionRegistrationType?  @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track              AdmissionTrack?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass     AdmissionClass?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  studyProgram       StudyProgram?      @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  student            Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)

  payments           AdmissionPayment[]

  @@map("admission_applications")
}

model AdmissionPayment {
  id            String               @id @default(uuid())
  applicationId String
  type          String               // "REGISTRATION", "RE_REGISTRATION"
  amount        Float
  status        String               @default("PENDING") // "PENDING", "VERIFYING", "PAID"
  paymentMethod String?              @default("Transfer Bank")
  proofUrl      String?
  notes         String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("admission_payments")
}

model AdmissionApplicant {
  id                  String          @id @default(uuid())
  registrationNumber  String          @unique // e.g. "PMB20270001"
  fullName            String
  email               String
  phone               String
  highSchool          String
  chosenStudyProgram  String
  jenjang             String?         @default("S1")
  jalurPendaftaran    String          @default("Reguler / Mandiri")
  status              AdmissionStatus @default(PENDING)
  testScore           Float?
  birthDate           String?
  gender              String?
  address             String?
  notes               String?
  verifiedAt          DateTime?
  verifiedBy          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@map("admission_applicants")
}

model AdmissionBrochure {
  id            String   @id @default("default-brochure")
  jenjang       String   @default("S1")
  title         String   @default("Brosur PMB ITN TA 2027/2028")
  fileName      String   @default("Brosur-PMB-ITN-2027.pdf")
  fileSize      String   @default("2.4 MB")
  fileSizeBytes Int      @default(2516582)
  mimeType      String   @default("application/pdf")
  fileUrl       String   @default("/downloads/brosur-pmb-2027.pdf")
  fileData      String?  @db.Text
  downloadCount Int      @default(0)
  description   String?  @default("Brosur resmi informasi pendaftaran mahasiswa baru Institut Teknologi Nusantara.")
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("admission_brochures")
}

model LandingPageSetting {
  id                    String    @id @default("default-setting")
  campusName            String    @default("Institut Teknologi Nusantara")
  campusShortName       String    @default("ITN")
  tagline               String    @default("Kampus Inovasi Teknologi Masa Depan")
  heroBadge             String    @default("Penerimaan Mahasiswa Baru TA 2026/2027 Telah Dibuka!")
  heroTitle             String    @default("Membentuk Generasi Unggul di Era Transformasi Digital")
  heroSubtitle          String    @default("Institut Teknologi Nusantara (ITN) memadukan keunggulan akademik, riset terapan mutakhir, dan ekosistem industri digital terdepan untuk mencetak profesional dan entrepreneur masa depan.")
  heroCtaText           String    @default("Daftar Sekarang (PMB)")
  heroCtaLink           String    @default("/pmb")
  heroSecondaryCtaText  String    @default("Jelajahi Program Studi")
  heroSecondaryCtaLink  String    @default("/#program-studi")
  
  // Sambutan Rektor
  rectorName            String    @default("Prof. Dr. Ir. Hendra Gunawan, M.Eng.")
  rectorTitle           String    @default("Rektor Institut Teknologi Nusantara")
  rectorQuote           String    @default("Pendidikan di ITN tidak hanya berfokus pada penguasaan teori, tetapi melahirkan solusi nyata bagi bangsa.")
  rectorSpeech          String    @default("Selamat datang di Institut Teknologi Nusantara.") @db.Text
  rectorImageUrl        String?
  
  // Pengumuman Banner
  announcementActive    Boolean   @default(true)
  announcementBadge     String    @default("INFO AKADEMIK")
  announcementText      String    @default("Pengisian KRS Semester Ganjil 2026/2027 berlangsung hingga 31 Agustus 2026. Pastikan konsultasi Dosen PA selesai tepat waktu.")
  announcementLink      String?   @default("/portal")

  // Kontak & Lokasi Kampus
  contactAddress        String    @default("Jl. Raya Pendidikan No. 45, Kampus Terpadu, Jakarta Selatan 12430")
  contactPhone          String    @default("(021) 7890-1234")
  contactEmail          String    @default("info@itn.ac.id")
  contactWhatsapp       String    @default("+62 812-3456-7890")
  
  // Media Sosial
  socialInstagram       String?   @default("https://instagram.com/itn_official")
  socialYoutube         String?   @default("https://youtube.com/@itnofficial")
  socialLinkedin        String?   @default("https://linkedin.com/school/itn-official")

  // Identitas & Legalitas Institusi
  foundationName        String    @default("Yayasan Pendidikan Teknologi Nusantara Mandiri")
  website               String    @default("https://itn.ac.id")
  academicEmail         String    @default("baak@itn.ac.id")
  accreditation         String    @default("Unggul")
  accreditationSk       String    @default("No. 1042/SK/BAN-PT/Ak/PT/VIII/2024")
  accreditationValidUntil String  @default("28 Agustus 2029")
  ptStatus              String    @default("Perguruan Tinggi Swasta (Aktif)")
  npsn                  String    @default("061024")
  ptCode                String    @default("071032")
  establishmentYear     Int       @default(1993)
  establishmentSk       String    @default("Kepmendikbud No. 048/D/O/1993")
  activeSemester        String    @default("Semester Gasal")
  activeAcademicYear    String    @default("2026/2027")

  // Pimpinan Perguruan Tinggi
  viceRector1           String    @default("Dr. Ir. Hendra Gunawan, M.T. (Bid. Akademik & Riset)")
  viceRector2           String    @default("Dra. Hj. Sri Wahyuni, M.M., Ak. (Bid. Keuangan & SDM)")
  viceRector3           String    @default("Dr. Rian Hidayat, S.Kom., M.Kom. (Bid. Kemahasiswaan & Kerjasama)")
  logoInitials          String    @default("ITN")
  logoUrl               String?

  // Identitas Visual, Kop Dokumen & Format Penomoran
  primaryColor          String    @default("#1E3A8A")
  accentColor           String    @default("#D4A017")
  themeName             String    @default("Nusantara Navy & Gold")
  kopLine1              String    @default("Yayasan Pendidikan Teknologi Nusantara Mandiri")
  kopLine2              String    @default("INSTITUT TEKNOLOGI NUSANTARA")
  kopContact            String    @default("Jl. DI Panjaitan No. 128, Jakarta Selatan 12340 | Telp: (021) 7888-9900 | Email: baak@itn.ac.id")
  pinFormat             String    @default("{KODE_PT}-{TAHUN}-{PRODI}-{NO_URUT}")
  nomorSuratFormat      String    @default("{NO}/ITN-BAAK/{BULAN_ROMAWI}/{TAHUN}")
  nimFormat             String    @default("{ANGKATAN_2DIGIT}{KODE_PRODI_3DIGIT}{NO_URUT_4DIGIT}")
  doubleBorderKop       Boolean   @default(true)

  updatedByUserId       String?
  updatedByUser         User?     @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("landing_page_settings")
}

