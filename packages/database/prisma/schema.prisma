  @@map("rooms")
}

model CalendarEvent {
  id           String   @id @default(uuid())
  title        String
  category     String   @default("Perkuliahan")
  startDate    String
  endDate      String
  academicYear String   @default("2026/2027")
  semester     String   @default("Gasal") // Gasal, Genap, Pendek
  target       String   @default("Seluruh Mahasiswa & Dosen")
  status       String   @default("Akan Datang") // Berlangsung, Akan Datang, Selesai
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("calendar_events")
}

model GradeScaleVersion {
  id             String       @id @default(uuid())
  academicYearId String?      // Grup skala ini berlaku untuk tahun akademik/semester yang mana
  label          String?      // Label tampilan opsional, default dari nama tahun akademik
  createdAt      DateTime     @default(now())

  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  scales         GradeScale[]

  @@map("grade_scale_versions")
}

model GradeScale {
  id         String   @id @default(uuid())
  versionId  String
  letter     String   // e.g. "A", "A-", "B+"
  minScore   Float    // Batas bawah nilai angka (inklusif)
  maxScore   Float    // Batas atas nilai angka (inklusif)
  gradePoint Float    // Bobot untuk perhitungan IPK, e.g. 4.0, 3.7
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  version    GradeScaleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, letter])
  @@map("grade_scales")
}

model Curriculum {
