// ==============================================================================
// ATURAN TANDA TANGAN DOKUMEN (DYNAMIC DOCUMENT SIGNATORY RULES)
// Siapa yang menandatangani tiap jenis dokumen resmi (KRS, KHS, surat, dst.) --
// dikelola dinamis oleh Super Admin, bukan ditulis tetap per halaman dokumen.
// ==============================================================================

enum SignerRole {
  DOSEN_PA // Dosen Pembimbing Akademik mahasiswa ybs
  KAPRODI // Ketua Program Studi mahasiswa ybs (StudyProgram.headOfProgram)
  DEKAN // Dekan fakultas mahasiswa ybs (Faculty.deanName)
  WAKIL_REKTOR_AKADEMIK // Wakil Rektor Bidang Akademik (profil institusi)
  REKTOR // Rektor (profil institusi)
}

model DocumentSignatureRule {
  id            String      @id @default(uuid())
  documentCode  String      @unique // kode bebas: 'KRS', 'KHS', 'SURAT_SKAK', dst.
  documentLabel String
  signer1Role   SignerRole  @default(DOSEN_PA)
  signer1Label  String? // label jabatan kustom; kosong = label baku per peran
  signer2Role   SignerRole?
  signer2Label  String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("document_signature_rules")
}

// ==============================================================================
// LAYANAN SURAT MAHASISWA (STUDENT LETTER REQUESTS)
// ==============================================================================

enum LetterRequestStatus {
  MENUNGGU_PA // menunggu verifikasi Dosen Pembimbing Akademik
  DIPROSES_BAAK // disetujui PA (atau tidak perlu PA), sedang diproses BAAK
  SELESAI // surat sudah terbit, siap diunduh
  DITOLAK // ditolak PA atau BAAK
}

model LetterRequest {
  id                      String              @id @default(uuid())
  requestNo               String              @unique // nomor tiket pengajuan (dibuat saat submit)
  letterNo                String? // nomor surat resmi, diisi saat status SELESAI
  typeCode                String // kode katalog: SKAK, SKP, SIP, SRB, SKBB, SKBP
  typeName                String // nama lengkap jenis surat (snapshot katalog saat pengajuan)
  purpose                 String              @db.Text
  targetInstitution       String
  targetPerson            String?
  studentNote             String?             @db.Text
  requiresAdvisorApproval Boolean             @default(true)
  status                  LetterRequestStatus @default(MENUNGGU_PA)

  advisorApprovedAt DateTime?
  advisorNote       String?   @db.Text

  processedAt      DateTime?
  processedByEmail String?
  letterBody       String?   @db.Text

  rejectionReason String? @db.Text
  rejectedBy      String? // 'ADVISOR' | 'BAAK'

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("letter_requests")
}

// ==============================================================================
// BIMBINGAN SKRIPSI / TUGAS AKHIR (KKN, KERJA PRAKTIK, DST.)
// Penetapan pembimbing per mahasiswa oleh Admin Akademik (BAAK) — berbeda dari
// Dosen Pembimbing Akademik (PA) di Student.advisorLecturerId, dan berbeda dari
// "Dosen Pengampu" di CourseClass yang mewakili satu kelas untuk banyak mahasiswa.
// ==============================================================================
// ================= JADWAL UJIAN (UTS / UAS) =================
enum ExamType {
  UTS
  UAS
}

model ExamSchedule {
  id             String   @id @default(uuid())
  courseClassId  String
  academicYearId String
  type           ExamType
  examDate       DateTime // tanggal ujian (disimpan 00:00 UTC)
  startTime      String // "HH:MM"
  endTime        String // "HH:MM"
  roomId         String?
  location       String? // lokasi bebas (dipakai jika ruang tidak dipilih dari master ruang)
  proctor1Id     String?
  proctor2Id     String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  courseClass  CourseClass  @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  proctor1     Lecturer?    @relation("ExamProctor1", fields: [proctor1Id], references: [id], onDelete: SetNull)
  proctor2     Lecturer?    @relation("ExamProctor2", fields: [proctor2Id], references: [id], onDelete: SetNull)
  seats        ExamSeat[]

  @@unique([courseClassId, type])
  @@index([academicYearId, type, examDate])
  @@map("exam_schedules")
}

/// Nomor kursi peserta pada satu jadwal ujian (digenerate BAAK; nomor 1..kapasitas ruang, unik per jadwal).
model ExamSeat {
  id             String   @id @default(uuid())
  examScheduleId String
  studentId      String
  seatNo         Int
  createdAt      DateTime @default(now())

  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
  @@unique([examScheduleId, seatNo])
  @@map("exam_seats")
}

// ================= YUDISIUM & KELULUSAN =================
// Mahasiswa mendaftar yudisium setelah syarat terpenuhi (SKS lulus, IPK, tugas akhir selesai,
// tagihan lunas). BAAK memverifikasi lalu menetapkan kelulusan (status mahasiswa -> GRADUATED).
enum GraduationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model GraduationApplication {
  id             String           @id @default(uuid())
  studentId      String           @unique
  status         GraduationStatus @default(SUBMITTED)
  // Snapshot syarat saat mendaftar (bukti verifikasi, tidak berubah walau nilai berubah kemudian).
  sksLulus       Int              @default(0)
  sksRequired    Int              @default(144)
  ipk            Float?
  thesisGrade    String?
  // Keputusan BAAK
  predicate      String? // mis. "Dengan Pujian", "Sangat Memuaskan"
  graduationDate DateTime?
  skNumber       String?
  adminNote      String?          @db.Text
  decidedAt      DateTime?
  appliedAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("graduation_applications")
}

// ================= TUGAS AKHIR / SKRIPSI (ALUR LENGKAP) =================
// Alur: pengajuan proposal -> plotting pembimbing (BAAK) -> bimbingan proposal -> ACC proposal
// -> daftar seminar proposal -> jadwal & penguji (BAAK) -> hasil sempro -> bimbingan skripsi
// -> ACC skripsi -> daftar ujian skripsi -> jadwal & penguji (BAAK) -> input nilai (BAAK).
// Terpisah dari ThesisSupervision (penetapan pembimbing per KRS) yang tetap dipakai halaman lama.
enum ThesisStage {
  PROPOSAL_SUBMITTED // proposal diajukan, menunggu plotting pembimbing
  PROPOSAL_REJECTED // proposal ditolak BAAK -- mahasiswa mengajukan ulang
  PROPOSAL_GUIDANCE // pembimbing sudah ditetapkan, bimbingan proposal
  PROPOSAL_APPROVED // proposal di-ACC pembimbing -- boleh daftar seminar proposal
  SEMPRO_REGISTERED // sudah daftar sempro, menunggu jadwal
  SEMPRO_SCHEDULED // jadwal & penguji sempro sudah ditetapkan
  SKRIPSI_GUIDANCE // sempro selesai, bimbingan skripsi
  SKRIPSI_APPROVED // skripsi di-ACC pembimbing -- boleh daftar ujian skripsi
  UJIAN_REGISTERED // sudah daftar ujian skripsi, menunggu jadwal
  UJIAN_SCHEDULED // jadwal & penguji ujian sudah ditetapkan
  COMPLETED // nilai akhir sudah diinput
}

enum ThesisPhase {
  PROPOSAL
  SKRIPSI
}

enum ThesisDefenseType {
  SEMPRO
  UJIAN
}

enum ThesisDefenseStatus {
  REGISTERED
  SCHEDULED
  DONE
}

model ThesisProject {
  id                   String      @id @default(uuid())
  studentId            String      @unique
  title                String
  abstract             String?     @db.Text
  proposalFileUrl      String?     @db.Text
  stage                ThesisStage @default(PROPOSAL_SUBMITTED)
  supervisor1Id        String?
  supervisor2Id        String?
  supervisorAssignedAt DateTime?
  adminNote            String?     @db.Text
  finalScore           Float?
  finalGrade           String?
  completedAt          DateTime?
  submittedAt          DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supervisor1 Lecturer?        @relation("ThesisProjectSupervisor1", fields: [supervisor1Id], references: [id], onDelete: SetNull)
  supervisor2 Lecturer?        @relation("ThesisProjectSupervisor2", fields: [supervisor2Id], references: [id], onDelete: SetNull)
  guidances   ThesisGuidance[]
  approvals   ThesisApproval[]
  defenses    ThesisDefense[]

  @@index([stage])
  @@map("thesis_projects")
}

model ThesisGuidance {
  id          String      @id @default(uuid())
  projectId   String
  phase       ThesisPhase
  lecturerId  String? // pembimbing yang mencatat / dituju
  chapter     String? // bab yang dibahas (dicatat dosen)
  topic       String
  notes       String?     @db.Text
  fileUrl     String?     @db.Text
  meetingDate DateTime    @default(now())
  status      String      @default("SUBMITTED") // SUBMITTED | REVIEWED (lama, dari mahasiswa) | RECORDED (dicatat dosen)
  feedback    String?     @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())

  project  ThesisProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lecturer Lecturer?     @relation("ThesisGuidanceLecturer", fields: [lecturerId], references: [id], onDelete: SetNull)

  @@index([projectId, phase])
  @@map("thesis_guidances")
}

/// Pengaturan bimbingan tugas akhir per kampus (satu baris): minimal bimbingan sebelum ACC dan daftar bab.
model ThesisSetting {
  id                  String   @id @default("default")
  minGuidanceProposal Int      @default(1)
  minGuidanceSkripsi  Int      @default(1)
  chapters            String[] @default(["Bab I", "Bab II", "Bab III", "Bab IV", "Bab V"])
  // Status nilai yang ditulis ke KRS dari hasil seminar/ujian: FINAL atau DRAFT
  gradeStatus         String   @default("FINAL")
  updatedAt           DateTime @updatedAt

  @@map("thesis_settings")
}

model ThesisApproval {
  id         String      @id @default(uuid())
  projectId  String
  phase      ThesisPhase
  lecturerId String
  approvedAt DateTime    @default(now())

  project  ThesisProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lecturer Lecturer      @relation("ThesisApprovalLecturer", fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase, lecturerId])
  @@map("thesis_approvals")
}

model ThesisDefense {
  id           String              @id @default(uuid())
  projectId    String
  type         ThesisDefenseType
  status       ThesisDefenseStatus @default(REGISTERED)
  fileUrl      String?             @db.Text
  registeredAt DateTime            @default(now())
  scheduledAt  DateTime?
  location     String?
  result       String? // LULUS | REVISI | TIDAK_LULUS
  score        Float?
  gradeLetter  String?
  gradeSyncedAt DateTime? // kapan nilai ini ditulis ke KRS (mata kuliah hasil pemetaan)
  gradeSyncNote String? // catatan penulisan nilai (berhasil / alasan tertunda)
  notes        String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  project   ThesisProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  examiners ThesisDefenseExaminer[]

  @@index([projectId, type])
  @@map("thesis_defenses")
}

model ThesisDefenseExaminer {
  id         String @id @default(uuid())
  defenseId  String
  lecturerId String
  role       String @default("PENGUJI") // KETUA | PENGUJI

  defense  ThesisDefense @relation(fields: [defenseId], references: [id], onDelete: Cascade)
  lecturer Lecturer      @relation("ThesisExaminerLecturer", fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([defenseId, lecturerId])
  @@map("thesis_defense_examiners")
}

model ThesisSupervision {
  id             String    @id @default(uuid())
  studentId      String
  courseId       String
  academicYearId String
  title          String?   @db.Text // judul skripsi/kegiatan, opsional & bisa menyusul
  supervisor1Id  String?
  supervisor2Id  String?
  notes          String?   @db.Text
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  supervisor1  Lecturer?    @relation("ThesisSupervisor1", fields: [supervisor1Id], references: [id], onDelete: SetNull)
  supervisor2  Lecturer?    @relation("ThesisSupervisor2", fields: [supervisor2Id], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId, academicYearId])
  @@map("thesis_supervisions")
}

model FinanceBankAccount {
  id            String   @id @default(uuid())
  bankName      String
  description   String?
  accountNumber String
  accountName   String
  balance       Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("finance_bank_accounts")
}

model FinanceBudgetItem {
  id           String   @id @default(uuid())
  category     String
  academicYear String   @default("2026/2027")
  allocated    Float    @default(0)
  spent        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("finance_budget_items")
}

// ==============================================================================
// MASTER KOMPONEN BIAYA & ATURAN PEMBIAYAAN (FEE RULES ENGINE)
// ==============================================================================

model FeeComponent {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. "SPP", "SKS", "PRAKTIKUM", "UJIAN", "REGISTRASI", "WISUDA"
  name          String // e.g. "SPP / Uang Kuliah Tunggal", "Biaya SKS Perkuliahan"
  defaultAmount Float // Tarif dasar standar (Rp)
  category      String   @default("SEMESTER") // "SEMESTER", "PER_SKS", "SEKALI_BAYAR"
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleItems    FeeRuleItem[]
  invoiceItems PaymentInvoiceItem[]

  @@map("fee_components")
}

enum FeeRuleBillingMode {
  UKT
  PER_SKS
}

model FeeRule {
  id           String             @id @default(uuid())
  name         String // e.g. "Aturan Beasiswa KIP-Kuliah"
  code         String             @unique // e.g. "RULE_KIP"
  description  String?            @db.Text
  priority     Int                @default(10) // Prioritas: angka makin besar makin prioritas
  academicYear String? // null = berlaku untuk semua tahun akademik
  billingMode  FeeRuleBillingMode @default(UKT) // UKT = flat per semester, PER_SKS = tarif x SKS diambil
  isActive     Boolean            @default(true)

  // Kondisi opsional pencocokan rule
  registrationTypeId String?
  trackId            String?
  classId            String?
  studyProgramId     String?
  waveId             String?

  registrationType AdmissionRegistrationType? @relation(fields: [registrationTypeId], references: [id], onDelete: SetNull)
  track            AdmissionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  admissionClass   AdmissionClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  studyProgram     StudyProgram?              @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  wave             AdmissionBatch?            @relation(fields: [waveId], references: [id], onDelete: SetNull)

  ruleItems   FeeRuleItem[]
  assignments StudentFeeAssignment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("fee_rules")
}

model FeeRuleItem {
  id             String   @id @default(uuid())
  feeRuleId      String
  feeComponentId String
  actionType     String   @default("NORMAL") // "NORMAL", "BEBAS", "DISKON_PERSENTASE", "DISKON_NOMINAL", "TARIF_KHUSUS"
  amountValue    Float? // Nilai diskon persen / diskon nominal / tarif khusus
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeRule      FeeRule      @relation(fields: [feeRuleId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent @relation(fields: [feeComponentId], references: [id], onDelete: Restrict)

  @@unique([feeRuleId, feeComponentId])
  @@map("fee_rule_items")
}

model StudentFeeAssignment {
  id           String   @id @default(uuid())
  studentId    String
  feeRuleId    String?
  academicYear String // e.g. "2026/2027"
  schemeName   String // e.g. "Skema Beasiswa KIP-Kuliah", "Skema Reguler Mandiri"
  snapshotData Json // Snapshot rincian aturan & komponen saat penetapan dilakukan
  notes        String?  @db.Text
  assignedAt   DateTime @default(now())
  assignedBy   String?  @default("SISTEM_PMB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeRule FeeRule? @relation(fields: [feeRuleId], references: [id], onDelete: SetNull)

  @@index([studentId, academicYear])
  @@map("student_fee_assignments")
}

model PaymentInvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  feeComponentId String?
  componentName  String
  baseAmount     Float
  actionType     String   @default("NORMAL") // "NORMAL", "BEBAS", "DISKON_PERSENTASE", "DISKON_NOMINAL", "TARIF_KHUSUS"
  actionValue    Float?
  discountAmount Float    @default(0)
  finalAmount    Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice      PaymentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent?  @relation(fields: [feeComponentId], references: [id], onDelete: SetNull)

  @@map("payment_invoice_items")
}

/// Catatan setiap berkas yang diunggah lewat /storage/upload (siapa, kapan, apa).
model UploadedFile {
  id             String   @id @default(uuid())
  key            String   @unique
  originalName   String
  mimeType       String
  size           Int
  folder         String
  isPrivate      Boolean  @default(true)
  driver         String   @default("local")
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@map("uploaded_files")
}

/// Pengaturan jam operasional live chat PMB (satu baris). mode: AUTO (ikuti jadwal) | OPEN (paksa buka) | CLOSED (paksa tutup).
/// schedule: [{ day: 0-6 (0 = Minggu), open: boolean, from: "08:00", to: "16:00" }] dalam waktu WIB.
model PmbChatSetting {
  id                   String   @id @default("default")
  mode                 String   @default("AUTO")
  schedule             Json
  offlineMessage       String   @default("Saat ini di luar jam operasional. Tinggalkan pesan, panitia akan membalas pada jam kerja.") @db.Text
  allowOfflineMessages Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("pmb_chat_settings")
}

/// Live chat PMB: satu percakapan per akun pendaftar, dibalas panitia PMB dari portal.
model PmbChatThread {
  id              String   @id @default(uuid())
  // Percakapan milik akun pendaftar (accountId) ATAU pengunjung anonim yang memulai chat dari
  // beranda PMB (visitorKey + nama & kontak yang ia isi). Tepat salah satu terisi.
  accountId       String?  @unique
  visitorKey      String?  @unique
  visitorName     String?
  visitorContact  String?
  status          String   @default("OPEN") // OPEN | CLOSED
  lastMessageAt   DateTime @default(now())
  // Jumlah pesan yang belum dibaca masing-masing pihak (diset 0 saat pihak itu membuka percakapan).
  applicantUnread Int      @default(0)
  staffUnread     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account  PmbAccount?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages PmbChatMessage[]

  @@index([lastMessageAt])
  @@map("pmb_chat_threads")
}

model PmbChatMessage {
  id           String   @id @default(uuid())
  threadId     String
  sender       String // APPLICANT | STAFF
  // Untuk pesan staf: akun panitia yang membalas (pencatatan internal; pendaftar hanya melihat "Panitia PMB").
  senderUserId String?
  senderName   String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  thread PmbChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("pmb_chat_messages")
}


/// Token pengaturan ulang kata sandi akun portal (mahasiswa, dosen, staf). Yang disimpan hanya HASH token;
/// tautan di email membawa token aslinya. Sekali pakai dan kedaluwarsa.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}


/// Skema komponen penilaian kampus (diatur Akademik). Berlaku mulai tahun akademik + semester `effectiveFromYearId`
/// sampai ada skema yang lebih baru; semua dosen memakai skema yang sama untuk semester itu.
model AssessmentScheme {
  id                  String   @id @default(uuid())
  name                String
  effectiveFromYearId String
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  effectiveFrom AcademicYear         @relation(fields: [effectiveFromYearId], references: [id], onDelete: Restrict)
  components    AssessmentComponent[]

  @@unique([effectiveFromYearId])
  @@map("assessment_schemes")
}

/// Satu komponen dalam skema (mis. Tugas 20%, UTS 30%, UAS 40%, Kehadiran 10%).
/// `source`: MANUAL = dosen mengisi nilainya; ATTENDANCE = otomatis dari persentase kehadiran.
model AssessmentComponent {
  id        String @id @default(uuid())
  schemeId  String
  code      String
  name      String
  /// Tidak dipakai: bobot ditentukan dosen per kelas (Kontrak Kuliah). Dibiarkan 0.
  weight    Float  @default(0)
  source    String @default("MANUAL")
  sortOrder Int    @default(0)

  scheme AssessmentScheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  scores EnrollmentComponentScore[]

  @@unique([schemeId, code])
  @@map("assessment_components")
}

/// Nilai satu mahasiswa (baris KRS) untuk satu komponen penilaian.
model EnrollmentComponentScore {
  id           String   @id @default(uuid())
  enrollmentId String
  componentId  String
  score        Float
  updatedAt    DateTime @updatedAt

  enrollment CourseEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  component  AssessmentComponent  @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, componentId])
  @@index([componentId])
  @@map("enrollment_component_scores")
}

/// Penghitung nomor urut surat per tahun (kenaikan atomik di database, aman untuk penerbitan bersamaan).
model LetterCounter {
  key       String   @id // mis. "2026"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("letter_counters")
}

/// Notifikasi dalam aplikasi untuk satu pengguna (tampil di lonceng portal).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // mis. THESIS, LETTER, KRS
  title     String
  body      String?   @db.Text
  link      String? // alamat halaman terkait (relatif)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
