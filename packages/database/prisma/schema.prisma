  // Orang Tua / Wali
  parentName   String?
  parentPhone  String?
  parentJob    String?
  parentIncome String?
  fatherName   String?
  fatherPhone  String?
  fatherJob    String?
  fatherIncome String?
  motherName   String?
  motherPhone  String?
