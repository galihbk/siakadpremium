{
  "name": "siakadpremium",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @siakad/database db:generate",
    "db:migrate": "pnpm --filter @siakad/database db:migrate",
    "db:push": "pnpm --filter @siakad/database db:push",
    "db:seed": "pnpm --filter @siakad/database db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@11.9.0"
}
