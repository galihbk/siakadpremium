# ==============================================================================
# SIAKAD Premium - konfigurasi SERVER (satu file untuk semua layanan)
#
# Di server: salin menjadi `.env` di folder proyek (CI melakukannya otomatis kalau belum ada).
# Dipakai bersama oleh: api, web, portal, pmb, p2m, p3m (lihat docker-compose.prod.yml).
# Jangan isi PORT di sini -- sudah ditetapkan di Dockerfile masing-masing layanan.
# ==============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# --- Alamat publik (dipakai browser & tautan di email) -----------------------
NEXT_PUBLIC_APP_URL=https://galihjp.com
NEXT_PUBLIC_WEB_URL=https://galihjp.com
NEXT_PUBLIC_PORTAL_URL=https://portal.galihjp.com
NEXT_PUBLIC_API_URL=/api/v1

# --- Alamat API di jaringan Docker (SSR & proxy Next.js) ----------------------
INTERNAL_API_URL=http://api:3001/api/v1

# --- API -----------------------------------------------------------------------
API_URL=http://localhost:3101
API_PREFIX=api/v1

# PostgreSQL in Docker network
DATABASE_URL="postgresql://siakad:siakad_secure_password_2026@postgres:5432/siakad_premium?schema=public"

# Redis in Docker network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=siakad_prod_jwt_super_secret_key_change_me_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=siakad_prod_refresh_secret_key_change_me
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=/app/uploads

# Email notifikasi (SMTP) - wajib diisi agar email verifikasi/reset PMB terkirim
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="STKIP MAJENANG"

# ==============================================================================
# INSTANCE BARU / DEMO KAMPUS (opsional) -- baris di bawah sengaja diberi komentar.
# Hapus tanda # hanya pada instance yang membutuhkannya.
# ==============================================================================
# Beberapa instance di satu mesin: beri nama berbeda (mempengaruhi nama container, volume, dan jaringan)
# dan port host yang berbeda. Bawaan "siakad" = instance utama.
# INSTANCE_NAME=kudus
# SIAKAD_WEB_PORT=3200
# SIAKAD_API_PORT=3201
# SIAKAD_PORTAL_PORT=3202
# SIAKAD_PMB_PORT=3203
# SIAKAD_P2M_PORT=3204
# SIAKAD_P3M_PORT=3205
#
# Database kosong: saat API menyala dan belum ada Super Admin, akun pertama dibuat otomatis dari nilai ini.
# Ganti kata sandi setelah login pertama; variabel ini boleh dihapus setelahnya.
# BOOTSTRAP_ADMIN_EMAIL=admin@kampus.ac.id
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Super Administrator
# BOOTSTRAP_CAMPUS_NAME=Nama Kampus
# BOOTSTRAP_CAMPUS_SHORT=NK

# Alamat publik tiap layanan (dibaca aplikasi saat berjalan, tidak perlu build ulang). WAJIB diisi bila penamaan domain
# tidak mengikuti pola portal.<domain> -- mis. Cloudflare Universal SSL hanya mencakup subdomain SATU tingkat,
# jadi pakai strip: portal-kudus.contoh.com, bukan portal.kudus.contoh.com.
# Kosongkan semuanya bila memakai pola portal.<domain>, pmb.<domain>, p2m.<domain>, p3m.<domain>.
# PUBLIC_WEB_URL=https://kudus.contoh.com
# PUBLIC_PORTAL_URL=https://portal-kudus.contoh.com
# PUBLIC_PMB_URL=https://pmb-kudus.contoh.com
# PUBLIC_P2M_URL=https://p2m-kudus.contoh.com
# PUBLIC_P3M_URL=https://p3m-kudus.contoh.com
# Alamat yang dipakai di tautan email verifikasi PMB (arahkan ke alamat PMB):
# NEXT_PUBLIC_APP_URL=https://pmb-kudus.contoh.com

# SEMENTARA - menu Super Admin "Langganan Mobile App": mengaktifkan/memperpanjang langganan aplikasi mobile NextVersa
# untuk kampus ini. SIAKAD memanggil Gateway NextVersa dari server (client id/secret tidak pernah sampai ke browser).
# Tutup menu: ubah MOBILE_SUBSCRIPTION_ENABLED menjadi false (endpoint langsung tertutup) dan, bila perlu, MOBILE_SUBSCRIPTION_ENABLED
# di apps/portal/src/lib/features.ts. Alamat Gateway wajib https (http hanya untuk localhost).
# MOBILE_SUBSCRIPTION_ENABLED=true
# NEXTVERSA_GATEWAY_URL=https://gateway.contoh.com
# NEXTVERSA_INSTITUTION_CODE=kode-kampus
# NEXTVERSA_CLIENT_ID=nvc_...
# NEXTVERSA_CLIENT_SECRET=nvs_...
