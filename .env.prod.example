# ==============================================================================
# SIAKAD Premium - konfigurasi SERVER (satu file untuk semua layanan)
#
# Di server: salin menjadi `.env` di folder proyek (CI melakukannya otomatis kalau belum ada).
# Dipakai bersama oleh: api, web, portal, pmb, p2m, p3m (lihat docker-compose.prod.yml).
# Jangan isi PORT di sini -- sudah ditetapkan di Dockerfile masing-masing layanan.
# ==============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# --- Alamat publik (dipakai browser & tautan di email) -----------------------
NEXT_PUBLIC_APP_URL=https://galihjp.com
NEXT_PUBLIC_WEB_URL=https://galihjp.com
NEXT_PUBLIC_PORTAL_URL=https://portal.galihjp.com
NEXT_PUBLIC_API_URL=/api/v1

# --- Alamat API di jaringan Docker (SSR & proxy Next.js) ----------------------
INTERNAL_API_URL=http://api:3001/api/v1

# --- API -----------------------------------------------------------------------
API_URL=http://localhost:3101
API_PREFIX=api/v1

# PostgreSQL in Docker network
DATABASE_URL="postgresql://siakad:siakad_secure_password_2026@postgres:5432/siakad_premium?schema=public"

# Redis in Docker network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=siakad_prod_jwt_super_secret_key_change_me_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=siakad_prod_refresh_secret_key_change_me
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=/app/uploads

# Email notifikasi (SMTP) - wajib diisi agar email verifikasi/reset PMB terkirim
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="STKIP MAJENANG"
