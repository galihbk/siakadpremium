# ==============================================================================
# SIAKAD Premium - Environment Variables Configuration
# ==============================================================================

# Database (PostgreSQL via Docker / Production Host)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/siakad_premium?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=siakad_premium
POSTGRES_PORT=5432

# Redis (Cache, Sessions, Queues, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Backend API Configuration
PORT=3001
API_URL=http://localhost:3001
API_PREFIX=api/v1
NODE_ENV=development

# JWT Authentication
JWT_SECRET=siakad_premium_enterprise_jwt_super_secret_key_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=siakad_premium_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Web Application (Website Kampus & PMB)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Portal Dashboard Application (Mahasiswa, Dosen, Admin)
PORTAL_PORT=3002
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002

# Storage & File Upload (local | cloud)
STORAGE=local
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Cloudflare R2 Storage (Digunakan jika STORAGE=cloud)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=siakad-bucket
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# Integrasi sistem OBE (endpoint baca-saja /api/v1/integrations/obe/*, server-ke-server).
# Isi dengan kunci acak panjang (mis. `openssl rand -base64 36`). Boleh beberapa kunci dipisah koma
# agar kunci dapat diganti tanpa henti layanan. Kosong = endpoint ditutup (503).
OBE_API_KEY=siakad_premium_enterprise_jwt_super_secret_key_2026
WEB_ORIGIN=http://localhost:3010

# SEMENTARA - menu Super Admin "Langganan Mobile App": mengaktifkan/memperpanjang langganan aplikasi mobile NextVersa
# untuk kampus ini. SIAKAD memanggil Gateway NextVersa dari server (client id/secret tidak pernah sampai ke browser).
# Tutup menu: ubah MOBILE_SUBSCRIPTION_ENABLED menjadi false (endpoint langsung tertutup) dan, bila perlu, MOBILE_SUBSCRIPTION_ENABLED
# di apps/portal/src/lib/features.ts. Alamat Gateway wajib https (http hanya untuk localhost).
# MOBILE_SUBSCRIPTION_ENABLED=true
# NEXTVERSA_GATEWAY_URL=https://gateway.contoh.com
# NEXTVERSA_INSTITUTION_CODE=kode-kampus
# NEXTVERSA_CLIENT_ID=nvc_...
# NEXTVERSA_CLIENT_SECRET=nvs_...
