# ==============================================================================
# SIAKAD Premium - Environment Variables Configuration
# ==============================================================================

# Database (PostgreSQL via Docker / Production Host)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/siakad_premium?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=siakad_premium
POSTGRES_PORT=5432

# Redis (Cache, Sessions, Queues, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Backend API Configuration
PORT=3001
API_URL=http://localhost:3001
API_PREFIX=api/v1
NODE_ENV=development

# JWT Authentication
JWT_SECRET=siakad_premium_enterprise_jwt_super_secret_key_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=siakad_premium_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Web Application (Website Kampus & PMB)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Portal Dashboard Application (Mahasiswa, Dosen, Admin)
PORTAL_PORT=3002
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002

# Storage & File Upload (local | cloud)
STORAGE=local
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Cloudflare R2 Storage (Digunakan jika STORAGE=cloud)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=siakad-bucket
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

